{
  "name": "medora-monorepo",
  "version": "2.0.0",
  "description": "Medora 2.0 - Hospital Management System Monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "postinstall": "node backend/node_modules/prisma/build/index.js generate --schema=backend/prisma/schema.prisma",
    "prisma:generate": "node backend/node_modules/prisma/build/index.js generate --schema=backend/prisma/schema.prisma",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "lint:backend": "npm run lint --prefix backend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "test:backend": "npm test --prefix backend",
    "test": "npm run test:backend"
  }
}
