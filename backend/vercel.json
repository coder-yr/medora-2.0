{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/**,prisma/**}",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/v1/admin/notifications/cron/process-outbox",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
