# Medora 2.0 Backend Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
CORS_ORIGIN=http://localhost:5173

# Database Connections (Supabase PostgreSQL via Prisma 7)
# For local development / testing without live Supabase, mock or local PostgreSQL URLs can be used
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medora?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/medora?schema=public

# Authentication & Security
# NEVER commit production secrets or default passwords to version control
JWT_SECRET=local-development-secret-key-change-in-production-min32chars
JWT_EXPIRES_IN=1d

# Optional Supabase Auth Integration Boundary
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=local-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-placeholder
SUPABASE_JWT_SECRET=local-supabase-jwt-secret-placeholder
