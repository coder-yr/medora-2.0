  category       String   @db.VarChar(100) // Test Name
  code           String?  @unique @db.VarChar(50)
  department     String?  @db.VarChar(100)
  referenceValue String?  @map("reference_value") @db.VarChar(255)
  description    String?  @db.Text
  price          Decimal? @db.Decimal(10, 2)
  sampleType     String?  @map("sample_type") @db.VarChar(50)
  turnaroundHours Int?    @default(24) @map("turnaround_hours")
  instructions   String?  @db.Text
  collectionNotes String? @map("collection_notes") @db.Text
  criticalLow    Decimal? @map("critical_low") @db.Decimal(10, 2)
  criticalHigh   Decimal? @map("critical_high") @db.Decimal(10, 2)
  isActive       Boolean  @default(true) @map("is_active")

  // Relations
  labTests   LabTest[]
  parameters LabTestParameter[]

  @@map("lab_category")
}

model LabTestParameter {
  id             BigInt    @id @default(autoincrement())
  labCategoryId  BigInt    @map("lab_category_id")
  name           String    @db.VarChar(100)
  unit           String?   @db.VarChar(50)
  referenceRange String?   @map("reference_range") @db.VarChar(255)
  gender         String?   @default("ALL") @db.VarChar(20)
  ageMin         Int?      @map("age_min")
  ageMax         Int?      @map("age_max")
