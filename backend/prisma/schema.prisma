  @@index([departmentId])
  @@index([isPrimary])
  @@map("staff_department_assignment")
}

model StaffEmploymentHistory {
  id             BigInt       @id @default(autoincrement())
  staffProfileId BigInt       @map("staff_profile_id")
  eventType      String       @map("event_type") @db.VarChar(50) // ONBOARDED, TRANSFER, DESIGNATION_CHANGE, STATUS_CHANGE, PROBATION_PASSED, OFFBOARDED, REACTIVATED
  previousValue  String?      @map("previous_value") @db.Text
  newValue       String?      @map("new_value") @db.Text
  effectiveDate  DateTime     @default(now()) @map("effective_date") @db.Date
  comments       String?      @db.Text
  recordedBy     BigInt       @map("recorded_by")
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  recorder       User         @relation("HistoryRecorder", fields: [recordedBy], references: [id])

  @@index([staffProfileId])
  @@index([eventType])
  @@index([effectiveDate])
  @@map("staff_employment_history")
}

