  prescriptionMedicines PrescriptionMedicine[]
  pharmacySaleItems    PharmacySaleItem[]
  batches              MedicineBatch[]
  stockMovements       StockMovement[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  dispensationItems    PharmacyDispensationItem[]
  adjustmentItems      StockAdjustmentItem[]
  returnItems          PharmacyReturnItem[]

  @@index([categoryId])
  @@index([manufacturerId])
  @@index([dosageFormId])
  @@index([unitId])
  @@index([supplierId])
  @@index([name])
  @@index([generic])
  @@map("medicine")
}

model PharmacyPayment {
  id             BigInt    @id @default(autoincrement())
  patientId      BigInt?   @map("patient")
  doctorId       BigInt?   @map("doctor")
  date           String    @db.VarChar(50)
  grossTotal     Decimal   @map("gross_total") @db.Decimal(10, 2)
  amountReceived Decimal   @map("amount_received") @db.Decimal(10, 2)
  discount       Decimal?  @default(0.00) @db.Decimal(10, 2)
  status         String    @default("unpaid") @db.VarChar(20)
  shiftCloseId   BigInt?   @map("shift_close_id")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  shiftClose ShiftClose?        @relation(fields: [shiftCloseId], references: [id])
  saleItems  PharmacySaleItem[]

  @@index([shiftCloseId])
  @@map("pharmacy_payment")
}

model PharmacySaleItem {
  id                BigInt  @id @default(autoincrement())
  pharmacyPaymentId BigInt  @map("pharmacy_payment_id")
  medicineId        BigInt  @map("medicine_id")
  medicineName      String  @map("medicine_name") @db.VarChar(100)
  quantity          Int
  unitPrice         Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice        Decimal @map("total_price") @db.Decimal(10, 2)

  // Relations
  pharmacyPayment PharmacyPayment @relation(fields: [pharmacyPaymentId], references: [id], onDelete: Cascade)
  medicine        Medicine        @relation(fields: [medicineId], references: [id])

  @@index([pharmacyPaymentId])
  @@map("pharmacy_sale_item")
}

// =============================================================================
// 7.1. BATCH INVENTORY, MOVEMENTS, PURCHASING & DISPENSING
// =============================================================================

model MedicineBatch {
  id              BigInt    @id @default(autoincrement())
  medicineId      BigInt    @map("medicine_id")
  batchNumber     String    @map("batch_number") @db.VarChar(100)
  mfgDate         String?   @map("mfg_date") @db.VarChar(50)
  expiryDate      DateTime  @map("expiry_date") @db.Date
  costPrice       Decimal   @map("cost_price") @db.Decimal(10, 2)
  sellingPrice    Decimal?  @map("selling_price") @db.Decimal(10, 2)
  initialQuantity Int       @map("initial_quantity")
  currentQuantity Int       @map("current_quantity")
  supplierId      BigInt?   @map("supplier_id")
  status          String    @default("ACTIVE") @db.VarChar(30) // ACTIVE, QUARANTINE, DEPLETED, EXPIRED, RECALLED
  notes           String?   @db.Text
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  medicine              Medicine                  @relation(fields: [medicineId], references: [id])
  supplier              Supplier?                 @relation(fields: [supplierId], references: [id])
  stockMovements        StockMovement[]
  goodsReceiptItems     GoodsReceiptItem[]
  dispensationItems     PharmacyDispensationItem[]
  adjustmentItems       StockAdjustmentItem[]
  returnItems           PharmacyReturnItem[]

  @@unique([medicineId, batchNumber])
  @@index([medicineId])
  @@index([expiryDate])
  @@index([status])
  @@index([supplierId])
  @@map("medicine_batch")
}

model StockMovement {
  id            BigInt    @id @default(autoincrement())
  medicineId    BigInt    @map("medicine_id")
  batchId       BigInt?   @map("batch_id")
  movementType  String    @map("movement_type") @db.VarChar(50) // PURCHASE_RECEIPT, DISPENSING, CUSTOMER_RETURN, SUPPLIER_RETURN, STOCK_ADJUSTMENT_IN, STOCK_ADJUSTMENT_OUT, EXPIRED_WRITE_OFF, DAMAGED_WRITE_OFF
  quantity      Int       // positive or negative
  balanceAfter  Int       @map("balance_after")
  unitCost      Decimal?  @map("unit_cost") @db.Decimal(10, 2)
  referenceType String?   @map("reference_type") @db.VarChar(50) // GOODS_RECEIPT, DISPENSATION, ADJUSTMENT, RETURN, INITIAL
  referenceId   BigInt?   @map("reference_id")
  performedBy   BigInt?   @map("performed_by")
  reason        String?   @db.Text
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  medicine Medicine       @relation(fields: [medicineId], references: [id])
  batch    MedicineBatch? @relation(fields: [batchId], references: [id])

  @@index([medicineId])
  @@index([batchId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("stock_movement")
}

model PurchaseOrder {
  id           BigInt              @id @default(autoincrement())
  poNumber     String              @unique @map("po_number") @db.VarChar(50)
  supplierId   BigInt              @map("supplier_id")
  orderDate    String              @map("order_date") @db.VarChar(50)
  expectedDate String?             @map("expected_date") @db.VarChar(50)
  totalAmount  Decimal             @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  status       String              @default("ORDERED") @db.VarChar(30) // DRAFT, ORDERED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  notes        String?             @db.Text
  createdById  BigInt?             @map("created_by_id")
  createdAt    DateTime?           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime?           @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  items        PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id               BigInt              @id @default(autoincrement())
  purchaseOrderId  BigInt              @map("purchase_order_id")
  medicineId       BigInt              @map("medicine_id")
  quantityOrdered  Int                 @map("quantity_ordered")
  quantityReceived Int                 @default(0) @map("quantity_received")
  unitCost         Decimal             @map("unit_cost") @db.Decimal(10, 2)
  lineTotal        Decimal             @map("line_total") @db.Decimal(12, 2)

  // Relations
  purchaseOrder    PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicine         Medicine            @relation(fields: [medicineId], references: [id])
  receiptItems     GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([medicineId])
  @@map("purchase_order_item")
}

model GoodsReceipt {
  id                    BigInt             @id @default(autoincrement())
  receiptNumber         String             @unique @map("receipt_number") @db.VarChar(50)
  purchaseOrderId       BigInt?            @map("purchase_order_id")
  supplierId            BigInt             @map("supplier_id")
  receiptDate           String             @map("receipt_date") @db.VarChar(50)
  supplierInvoiceNumber String?            @map("supplier_invoice_number") @db.VarChar(100)
  totalAmount           Decimal            @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  notes                 String?            @db.Text
  receivedById          BigInt?            @map("received_by_id")
  createdAt             DateTime?          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime?          @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  purchaseOrder         PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  supplier              Supplier           @relation(fields: [supplierId], references: [id])
  items                 GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@map("goods_receipt")
}

model GoodsReceiptItem {
  id                  BigInt             @id @default(autoincrement())
  goodsReceiptId      BigInt             @map("goods_receipt_id")
  purchaseOrderItemId BigInt?            @map("purchase_order_item_id")
  medicineId          BigInt             @map("medicine_id")
  batchId             BigInt?            @map("batch_id")
  batchNumber         String             @map("batch_number") @db.VarChar(100)
  mfgDate             String?            @map("mfg_date") @db.VarChar(50)
  expiryDate          DateTime           @map("expiry_date") @db.Date
  quantityReceived    Int                @map("quantity_received")
  unitCost            Decimal            @map("unit_cost") @db.Decimal(10, 2)
  sellingPrice        Decimal?           @map("selling_price") @db.Decimal(10, 2)
  lineTotal           Decimal            @map("line_total") @db.Decimal(12, 2)

  // Relations
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  medicine            Medicine           @relation(fields: [medicineId], references: [id])
  batch               MedicineBatch?     @relation(fields: [batchId], references: [id])

  @@index([goodsReceiptId])
  @@index([medicineId])
  @@index([batchId])
  @@map("goods_receipt_item")
}

model PharmacyDispensation {
  id                 BigInt                     @id @default(autoincrement())
  dispensationNumber String                     @unique @map("dispensation_number") @db.VarChar(50)
  prescriptionId     BigInt?                    @map("prescription_id")
  patientId          BigInt?                    @map("patient_id")
  doctorId           BigInt?                    @map("doctor_id")
  patientName        String?                    @map("patient_name") @db.VarChar(100)
  dispenseDate       String                     @map("dispense_date") @db.VarChar(50)
  subtotal           Decimal                    @default(0.00) @db.Decimal(12, 2)
  discount           Decimal                    @default(0.00) @db.Decimal(12, 2)
  tax                Decimal                    @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal                    @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  status             String                     @default("COMPLETED") @db.VarChar(30) // COMPLETED, RETURNED, CANCELLED
  invoiceId          BigInt?                    @map("invoice_id")
  dispensedById      BigInt?                    @map("dispensed_by_id")
  admissionId        BigInt?                    @map("admission_id")
  notes              String?                    @db.Text
  createdAt          DateTime?                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime?                  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  prescription       Prescription?              @relation(fields: [prescriptionId], references: [id])
  patient            Patient?                   @relation(fields: [patientId], references: [id])
  doctor             Doctor?                    @relation(fields: [doctorId], references: [id])
  invoice            Payment?                   @relation(fields: [invoiceId], references: [id])
  admission          Admission?                 @relation(fields: [admissionId], references: [id])
  items              PharmacyDispensationItem[]
  returns            PharmacyReturn[]

  @@index([prescriptionId])
  @@index([patientId])
  @@index([doctorId])
  @@index([invoiceId])
  @@index([dispenseDate])
  @@index([admissionId])
  @@map("pharmacy_dispensation")
}

model PharmacyDispensationItem {
  id                     BigInt                @id @default(autoincrement())
  dispensationId         BigInt                @map("dispensation_id")
  prescriptionMedicineId BigInt?               @map("prescription_medicine_id")
  medicineId             BigInt?               @map("medicine_id")
  batchId                BigInt?               @map("batch_id")
  medicineName           String                @map("medicine_name") @db.VarChar(200)
  batchNumber            String?               @map("batch_number") @db.VarChar(100)
  quantity               Int
  unitPrice              Decimal               @map("unit_price") @db.Decimal(10, 2)
  totalPrice             Decimal               @map("total_price") @db.Decimal(10, 2)
  returnedQuantity       Int                   @default(0) @map("returned_quantity")

  // Relations
  dispensation           PharmacyDispensation  @relation(fields: [dispensationId], references: [id], onDelete: Cascade)
  prescriptionMedicine   PrescriptionMedicine? @relation(fields: [prescriptionMedicineId], references: [id])
  medicine               Medicine?             @relation(fields: [medicineId], references: [id])
  batch                  MedicineBatch?        @relation(fields: [batchId], references: [id])
  returnItems            PharmacyReturnItem[]

  @@index([dispensationId])
  @@index([prescriptionMedicineId])
  @@index([medicineId])
  @@index([batchId])
  @@map("pharmacy_dispensation_item")
}

model StockAdjustment {
  id               BigInt                @id @default(autoincrement())
  adjustmentNumber String                @unique @map("adjustment_number") @db.VarChar(50)
  adjustmentDate   String                @map("adjustment_date") @db.VarChar(50)
  reason           String                @db.VarChar(100) // PHYSICAL_COUNT, DAMAGED, EXPIRED, AUDIT_CORRECTION, OTHER
  status           String                @default("APPROVED") @db.VarChar(30) // PENDING, APPROVED, REJECTED
  adjustedById     BigInt?               @map("adjusted_by_id")
  approvedById     BigInt?               @map("approved_by_id")
  notes            String?               @db.Text
  createdAt        DateTime?             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime?             @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  items            StockAdjustmentItem[]

  @@index([adjustmentDate])
  @@index([status])
  @@map("stock_adjustment")
}

model StockAdjustmentItem {
  id               BigInt          @id @default(autoincrement())
  adjustmentId     BigInt          @map("adjustment_id")
  medicineId       BigInt          @map("medicine_id")
  batchId          BigInt          @map("batch_id")
  systemQuantity   Int             @map("system_quantity")
  physicalQuantity Int             @map("physical_quantity")
  difference       Int             // physical - system (can be positive or negative)
  unitCost         Decimal?        @map("unit_cost") @db.Decimal(10, 2)

  // Relations
  adjustment       StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  medicine         Medicine        @relation(fields: [medicineId], references: [id])
  batch            MedicineBatch   @relation(fields: [batchId], references: [id])

  @@index([adjustmentId])
  @@index([medicineId])
  @@index([batchId])
  @@map("stock_adjustment_item")
}

model PharmacyReturn {
  id                 BigInt                @id @default(autoincrement())
  returnNumber       String                @unique @map("return_number") @db.VarChar(50)
  returnType         String                @map("return_type") @db.VarChar(30) // PATIENT_RETURN, SUPPLIER_RETURN
  dispensationId     BigInt?               @map("dispensation_id")
  supplierId         BigInt?               @map("supplier_id")
  returnDate         String                @map("return_date") @db.VarChar(50)
  reason             String                @db.Text
  totalRefund        Decimal               @default(0.00) @map("total_refund") @db.Decimal(12, 2)
  restockToInventory Boolean               @default(true) @map("restock_to_inventory")
  processedById      BigInt?               @map("processed_by_id")
  createdAt          DateTime?             @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  dispensation       PharmacyDispensation? @relation(fields: [dispensationId], references: [id])
  supplier           Supplier?             @relation(fields: [supplierId], references: [id])
  items              PharmacyReturnItem[]

  @@index([dispensationId])
  @@index([supplierId])
  @@index([returnType])
  @@map("pharmacy_return")
}

model PharmacyReturnItem {
  id                 BigInt                    @id @default(autoincrement())
  returnId           BigInt                    @map("return_id")
  dispensationItemId BigInt?                   @map("dispensation_item_id")
  medicineId         BigInt                    @map("medicine_id")
  batchId            BigInt                    @map("batch_id")
  quantity           Int
  unitPrice          Decimal                   @map("unit_price") @db.Decimal(10, 2)
  totalRefund        Decimal                   @map("total_refund") @db.Decimal(12, 2)
  condition          String                    @default("SALEABLE") @db.VarChar(30) // SALEABLE, DAMAGED, EXPIRED

  // Relations
  return             PharmacyReturn            @relation(fields: [returnId], references: [id], onDelete: Cascade)
  dispensationItem   PharmacyDispensationItem? @relation(fields: [dispensationItemId], references: [id])
  medicine           Medicine                  @relation(fields: [medicineId], references: [id])
  batch              MedicineBatch             @relation(fields: [batchId], references: [id])

  @@index([returnId])
  @@index([dispensationItemId])
  @@index([medicineId])
  @@index([batchId])
  @@map("pharmacy_return_item")
}

// =============================================================================
// 8. BILLING, INVOICES & CASH BALANCING
// =============================================================================

model PaymentCategory {
  id             BigInt    @id @default(autoincrement())
  category       String    @db.VarChar(100) // Service Name
  description    String?   @db.Text
  cPrice         Decimal   @map("c_price") @db.Decimal(10, 2) // Default list price
  dCommission    Decimal?  @map("d_commission") @db.Decimal(5, 2) // Default share %
  kind           String    @default("misc") @db.VarChar(20) // consultation, procedure, lab, etc.
  active         Boolean   @default(true)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  servicePrices  ServicePrice[]
  invoiceItems   InvoiceItem[]
  radiologyExams RadiologyExam[]

  @@map("payment_category")
}

model ServicePrice {
  id                BigInt    @id @default(autoincrement())
  paymentCategoryId BigInt    @map("payment_category_id")
  patientTypeId     BigInt    @map("patient_type_id")
  opdPrice          Decimal?  @map("opd_price") @db.Decimal(10, 2)
  ipdPrice          Decimal?  @map("ipd_price") @db.Decimal(10, 2)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  paymentCategory PaymentCategory @relation(fields: [paymentCategoryId], references: [id], onDelete: Cascade)
  patientType     PatientType     @relation(fields: [patientTypeId], references: [id], onDelete: Cascade)

  @@unique([paymentCategoryId, patientTypeId])
  @@map("service_price")
}

model Payment {
  id              BigInt    @id @default(autoincrement())
  patientId       BigInt    @map("patient")
  doctor          String?   @db.VarChar(100)
  referringDoctor String?   @map("referring_doctor") @db.VarChar(100)
  date            String    @db.VarChar(50)
  amount          Decimal   @default(0.00) @db.Decimal(12, 2) // Subtotal
  grossTotal      Decimal   @map("gross_total") @db.Decimal(12, 2) // Subtotal - discount + vat
  amountReceived  Decimal   @default(0.00) @map("amount_received") @db.Decimal(12, 2)
  discount        Decimal?  @default(0.00) @db.Decimal(12, 2)
  vat             Decimal?  @default(0.00) @db.Decimal(12, 2)
  status          String    @default("unpaid") @db.VarChar(20) // paid, part paid, unpaid
  patientTypeId   BigInt?   @map("patient_type_id")
  careSetting     String    @default("opd") @map("care_setting") @db.VarChar(10) // opd, ipd
  shiftCloseId    BigInt?   @map("shift_close_id")
  branchId        BigInt?   @map("branch_id")
  remarks         String?   @db.Text
  doctorName      String?   @map("doctor_name") @db.VarChar(100)
  user            String?   @db.VarChar(100)
  dateString      String?   @map("date_string") @db.VarChar(50)
  patientName     String?   @map("patient_name") @db.VarChar(100)
  patientPhone    String?   @map("patient_phone") @db.VarChar(50)
  patientAddress  String?   @map("patient_address") @db.VarChar(255)
  category        String?   @db.VarChar(255)
  categoryName    String?   @map("category_name") @db.VarChar(1000)
  categoryAmount  String?   @map("category_amount") @db.VarChar(1000)
  admissionId     BigInt?   @map("admission_id")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient         Patient          @relation(fields: [patientId], references: [id])
  patientType     PatientType?     @relation(fields: [patientTypeId], references: [id])
  branch          HospitalBranch?  @relation(fields: [branchId], references: [id])
  shiftClose      ShiftClose?      @relation(fields: [shiftCloseId], references: [id])
  admission       Admission?       @relation(fields: [admissionId], references: [id])
  inpatientFolios InpatientFolio[]
  items           InvoiceItem[]
  payments        InvoicePayment[]
  doctorShares    DoctorShare[]
  radiologyOrders RadiologyOrder[]
  pharmacyDispensations PharmacyDispensation[]
  labs            Lab[]

  @@index([patientId])
  @@index([status])
  @@index([shiftCloseId])
  @@index([admissionId])
  @@map("payment")
}

model InvoiceItem {
  id                BigInt   @id @default(autoincrement())
  paymentId         BigInt   @map("payment_id")
  paymentCategoryId BigInt?  @map("payment_category_id")
  name              String   @db.VarChar(200)
  quantity          Int      @default(1)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal         Decimal  @map("line_total") @db.Decimal(12, 2)
  doctorId          BigInt?  @map("doctor_id")

  // Relations
  payment         Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentCategory PaymentCategory? @relation(fields: [paymentCategoryId], references: [id])
  doctor          Doctor?          @relation(fields: [doctorId], references: [id])
  doctorShares    DoctorShare[]

  @@index([paymentId])
  @@map("invoice_item")
}

model InvoicePayment {
  id           BigInt    @id @default(autoincrement())
  paymentId    BigInt    @map("payment_id")
  date         String?   @db.VarChar(50)
  amount       Decimal   @db.Decimal(12, 2)
  method       String?   @default("Cash") @db.VarChar(60) // Cash, Bank transfer, Card, Cheque, Online, Write-off
  reference    String?   @db.VarChar(120)
  paidAt       String?   @map("paid_at") @db.VarChar(100)
  receivedBy   BigInt?   @map("received_by")
  shiftCloseId BigInt?   @map("shift_close_id")
  user         String?   @db.VarChar(50)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  payment    Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  shiftClose ShiftClose? @relation(fields: [shiftCloseId], references: [id])

  @@index([paymentId])
  @@index([shiftCloseId])
  @@map("invoice_payment")
}

model ShiftClose {
  id                BigInt    @id @default(autoincrement())
  userId            BigInt    @map("user_id")
  closedAt          DateTime  @map("closed_at") @db.Timestamptz
  expectedCash      Decimal   @map("expected_cash") @db.Decimal(12, 2)
  countedCash       Decimal   @map("counted_cash") @db.Decimal(12, 2)
  discrepancy       Decimal   @db.Decimal(12, 2)
  bankTransferTotal Decimal   @default(0.00) @map("bank_transfer_total") @db.Decimal(12, 2)
  cardTotal         Decimal   @default(0.00) @map("card_total") @db.Decimal(12, 2)
  chequeTotal       Decimal   @default(0.00) @map("cheque_total") @db.Decimal(12, 2)
  otherTotal        Decimal   @default(0.00) @map("other_total") @db.Decimal(12, 2)
  writeOffTotal     Decimal   @default(0.00) @map("write_off_total") @db.Decimal(12, 2)
  notes             String?   @db.Text
  status            String    @default("closed") @db.VarChar(20) // closed, verified
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user             User              @relation(fields: [userId], references: [id])
  invoices         Payment[]
  invoicePayments  InvoicePayment[]
  pharmacyPayments PharmacyPayment[]

  @@index([userId])
  @@map("shift_close")
}

// =============================================================================
// 9. DOCTOR REVENUE SHARE
// =============================================================================

model DoctorShare {
  id            BigInt    @id @default(autoincrement())
  paymentId     BigInt    @map("payment_id")
  invoiceItemId BigInt?   @map("invoice_item_id")
  doctorId      BigInt    @map("doctor_id")
  shareRuleId   BigInt?   @map("share_rule_id")
  role          String    @default("performing") @db.VarChar(20) // performing or referring
  baseAmount    Decimal   @map("base_amount") @db.Decimal(10, 2)
  percent       Decimal?  @map("percent") @db.Decimal(5, 2)
  amount        Decimal   @map("amount") @db.Decimal(10, 2)
  status        String    @default("pending") @db.VarChar(20) // pending, approved, paid
  approvedBy    BigInt?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz
  payoutRef     String?   @map("payout_ref") @db.VarChar(50)
  paidAt        DateTime? @map("paid_at") @db.Timestamptz
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  doctor      Doctor       @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
  @@index([status])
  @@map("doctor_share")
}
