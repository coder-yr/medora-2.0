// =============================================================================
// 3. PATIENTS & INPATIENT WARDS
// =============================================================================

model PatientType {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(50)
  slug        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  active      Boolean   @default(true)
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patients      Patient[]
  servicePrices ServicePrice[]
  invoices      Payment[]
  visitFees     VisitFee[]

  @@map("patient_type")
}

model Patient {
  id               BigInt    @id @default(autoincrement())
  patientId        String?   @unique @map("patient_id") @db.VarChar(100) // Format: 000001
  name             String    @db.VarChar(100)
  email            String?   @db.VarChar(100)
  phone            String?   @db.VarChar(100)
  address          String?   @db.VarChar(255)
  birthdate        String?   @db.VarChar(100)
  age              String?   @db.VarChar(100)
  sex              String?   @db.VarChar(50)
  bloodGroup       String?   @map("bloodgroup") @db.VarChar(50)
  patientTypeId    BigInt?   @map("patient_type_id")
  cnic             String?   @db.VarChar(50)
  fatherName       String?   @map("father_name") @db.VarChar(100)
  guardianRelation String?   @map("guardian_relation") @db.VarChar(50)
  guardianMrn      String?   @map("guardian_mrn") @db.VarChar(50)
  mlc              Boolean   @default(false)
  oldMrn           String?   @map("old_mrn") @db.VarChar(50)
  employeeNo       String?   @map("employee_no") @db.VarChar(50)
  altPhone         String?   @map("alt_phone") @db.VarChar(50)
  city             String?   @db.VarChar(100)
  branchId         BigInt?   @map("branch_id")
  imageUrl         String?   @map("img_url") @db.VarChar(255)
  attendingDoctor  String?   @map("doctor") @db.VarChar(100)
  addDate          String?   @map("add_date") @db.VarChar(100)
  registrationTime String?   @map("registration_time") @db.VarChar(100)
  ionUserId        String?   @map("ion_user_id") @db.VarChar(100)
  howAdded         String?   @map("how_added") @db.VarChar(100)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Clinic Edition fields (Phase 10.5.1)
  emergencyContactName     String?   @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactPhone    String?   @map("emergency_contact_phone") @db.VarChar(50)
  emergencyContactRelation String?   @map("emergency_contact_relation") @db.VarChar(50)
  allergies                String?   @db.Text
  medicalHistory           String?   @map("medical_history") @db.Text
  surgicalHistory          String?   @map("surgical_history") @db.Text
  familyHistory            String?   @map("family_history") @db.Text
  currentMedications       String?   @map("current_medications") @db.Text

  // Relations
  patientType      PatientType?      @relation(fields: [patientTypeId], references: [id])
  branch           HospitalBranch?   @relation(fields: [branchId], references: [id])
  appointments     Appointment[]
  allotedBeds      AllotedBed[]
  medicalHistories MedicalHistory[]
  consultations    Consultation[]
  prescriptions    Prescription[]
  labOrders        Lab[]
  radiologyOrders  RadiologyOrder[]
  invoices         Payment[]
  patientDeposits  PatientDeposit[]
  pharmacyDispensations PharmacyDispensation[]
  admissions       Admission[]
  inpatientFolios  InpatientFolio[]
  notificationRecipients NotificationRecipient[]
  notificationPreferences NotificationPreference?
  documents        PatientDocument[]
  followUps        FollowUp[]
  criticalLabEscalations CriticalLabEscalation[]

  @@index([patientTypeId])
  @@index([branchId])
  @@index([cnic])
  @@index([phone])
  @@index([oldMrn])
  @@map("patient")
}

model PatientDocument {
  id             BigInt          @id @default(autoincrement())
  patientId      BigInt          @map("patient_id")
  branchId       BigInt?         @map("branch_id")
  title          String          @db.VarChar(150)
  documentType   String          @default("GENERAL") @map("document_type") @db.VarChar(50)
  fileUrl        String          @map("file_url") @db.VarChar(500)
  fileSize       Int?            @map("file_size")
  mimeType       String?         @map("mime_type") @db.VarChar(100)
  notes          String?         @db.Text
  uploadedById   BigInt?         @map("uploaded_by_id")
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?       @updatedAt @map("updated_at") @db.Timestamptz

  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branch         HospitalBranch? @relation(fields: [branchId], references: [id])
  uploadedBy     User?           @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([patientId])
  @@index([branchId])
  @@map("patient_documents")
}

model BedCategory {
  id          BigInt    @id @default(autoincrement())
  category    String    @db.VarChar(100) // Ward Name (e.g. General Ward, ICU)
  code        String?   @db.VarChar(50)  // Ward Code (e.g. GW-01, ICU-A)
  description String?   @db.Text
  baseRate    Decimal   @default(0.00) @map("base_rate") @db.Decimal(10, 2)
  billingUnit String    @default("DAILY") @map("billing_unit") @db.VarChar(20)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  beds        Bed[]
  admissions  Admission[]

  @@map("bed_category")
}

model Bed {
  id          BigInt    @id @default(autoincrement())
  categoryId  BigInt    @map("category")
  number      String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  status      String    @default("AVAILABLE") @db.VarChar(50)
  isActive    Boolean   @default(true) @map("is_active")
  branchId    BigInt?   @map("branch_id")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  category    BedCategory          @relation(fields: [categoryId], references: [id])
  branch      HospitalBranch?      @relation(fields: [branchId], references: [id])
  allotedBeds AllotedBed[]
  admissions  Admission[]
  allocations BedAllocationHistory[]

  @@unique([categoryId, number])
  @@index([branchId])
  @@index([status])
  @@map("bed")
}

model AllotedBed {
  id          BigInt    @id @default(autoincrement())
  patientId   BigInt    @map("patient")
  bedId       BigInt    @map("bed_id")
  aTime       String    @map("a_time") @db.VarChar(100) // Admission time
  dTime       String?   @map("d_time") @db.VarChar(100) // Discharge time (NULL = currently occupied)
  category    String?   @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient     Patient   @relation(fields: [patientId], references: [id])
  bed         Bed       @relation(fields: [bedId], references: [id])

  @@index([patientId])
  @@index([bedId])
  @@index([dTime])
  @@map("alloted_bed")
}

model Admission {
  id                    BigInt    @id @default(autoincrement())
  admissionNumber       String    @unique @map("admission_number") @db.VarChar(50)
  patientId             BigInt    @map("patient_id")
  attendingDoctorId     BigInt?   @map("attending_doctor_id")
  admittingDoctorId     BigInt?   @map("admitting_doctor_id")
  wardId                BigInt    @map("ward_id")
  bedId                 BigInt    @map("bed_id")
  admissionDate         DateTime  @map("admission_date") @db.Timestamptz
  expectedDischargeDate DateTime? @map("expected_discharge_date") @db.Timestamptz
  actualDischargeDate   DateTime? @map("actual_discharge_date") @db.Timestamptz
  admissionType         String    @default("ELECTIVE") @map("admission_type") @db.VarChar(50) // EMERGENCY, ELECTIVE, TRANSFER, URGENT
  admissionReason       String?   @map("admission_reason") @db.Text
  diagnosis             String?   @db.Text
  clinicalNotes         String?   @map("clinical_notes") @db.Text
  status                String    @default("ADMITTED") @db.VarChar(50) // PENDING, ADMITTED, TRANSFERRED, DISCHARGE_PENDING, DISCHARGED, CANCELLED
  dischargeSummary      String?   @map("discharge_summary") @db.Text
  dischargeCondition    String?   @map("discharge_condition") @db.VarChar(100) // RECOVERED, IMPROVED, UNCHANGED, REFERRED, DECEASED, LAMA
  createdBy             BigInt?   @map("created_by")
  dischargedBy          BigInt?   @map("discharged_by")
  branchId              BigInt?   @map("branch_id")
  createdAt             DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient               Patient                 @relation(fields: [patientId], references: [id])
  attendingDoctor       Doctor?                 @relation("AttendingDoctor", fields: [attendingDoctorId], references: [id])
  admittingDoctor       Doctor?                 @relation("AdmittingDoctor", fields: [admittingDoctorId], references: [id])
  ward                  BedCategory             @relation(fields: [wardId], references: [id])
  bed                   Bed                     @relation(fields: [bedId], references: [id])
  branch                HospitalBranch?         @relation(fields: [branchId], references: [id])
  allocations           BedAllocationHistory[]
  folio                 InpatientFolio?
  pharmacyDispensations PharmacyDispensation[]
  labOrders             Lab[]
  radiologyOrders       RadiologyOrder[]
  invoices              Payment[]

  @@index([patientId])
  @@index([bedId])
  @@index([wardId])
  @@index([status])
  @@index([admissionDate])
  @@map("admissions")
}

model BedAllocationHistory {
  id             BigInt    @id @default(autoincrement())
  admissionId    BigInt    @map("admission_id")
  bedId          BigInt    @map("bed_id")
  allocatedAt    DateTime  @map("allocated_at") @db.Timestamptz
  releasedAt     DateTime? @map("released_at") @db.Timestamptz
  rateSnapshot   Decimal   @default(0.00) @map("rate_snapshot") @db.Decimal(10, 2)
  transferReason String?   @map("transfer_reason") @db.VarChar(255)
  allocatedBy    BigInt?   @map("allocated_by")
  releasedBy     BigInt?   @map("released_by")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  admission      Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  bed            Bed       @relation(fields: [bedId], references: [id])

  @@index([admissionId])
  @@index([bedId])
  @@index([releasedAt])
  @@map("bed_allocation_history")
}

model InpatientFolio {
  id             BigInt    @id @default(autoincrement())
  folioNumber    String    @unique @map("folio_number") @db.VarChar(50) // FOL-YYYYMMDD-XXXX
  admissionId    BigInt    @unique @map("admission_id")
  patientId      BigInt    @map("patient_id")
  status         String    @default("OPEN") @db.VarChar(50) // OPEN, CLOSED, SETTLED
  totalCharges   Decimal   @default(0.00) @map("total_charges") @db.Decimal(12, 2)
  totalPaid      Decimal   @default(0.00) @map("total_paid") @db.Decimal(12, 2)
  balance        Decimal   @default(0.00) @db.Decimal(12, 2)
  settledAt      DateTime? @map("settled_at") @db.Timestamptz
  settledBy      BigInt?   @map("settled_by")
  finalInvoiceId BigInt?   @map("final_invoice_id")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  admission      Admission            @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patient        Patient              @relation(fields: [patientId], references: [id])
  finalInvoice   Payment?             @relation(fields: [finalInvoiceId], references: [id])
  items          InpatientFolioItem[]

  @@index([patientId])
  @@index([status])
  @@map("inpatient_folios")
}

model InpatientFolioItem {
  id             BigInt    @id @default(autoincrement())
  folioId        BigInt    @map("folio_id")
  sourceModule   String    @map("source_module") @db.VarChar(50) // BED, PHARMACY, LABORATORY, RADIOLOGY, SERVICE
  sourceRecordId String?   @map("source_record_id") @db.VarChar(100) // Dispensation ID, Lab Order ID, etc.
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(150) // Prevents duplicate charges
  chargeCategory String    @map("charge_category") @db.VarChar(100)
  description    String    @db.VarChar(255)
  quantity       Int       @default(1)
  unitPrice      Decimal   @map("unit_price") @db.Decimal(10, 2)
  totalAmount    Decimal   @map("total_amount") @db.Decimal(12, 2)
  postedAt       DateTime  @default(now()) @map("posted_at") @db.Timestamptz
  postedBy       BigInt?   @map("posted_by")
  isReversed     Boolean   @default(false) @map("is_reversed")
  reversedAt     DateTime? @map("reversed_at") @db.Timestamptz
  reversedBy     BigInt?   @map("reversed_by")
  reversalReason String?   @map("reversal_reason") @db.VarChar(255)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  folio          InpatientFolio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@index([sourceModule, sourceRecordId])
  @@map("inpatient_folio_items")
}

model MedicalHistory {
  id               BigInt    @id @default(autoincrement())
  patientId        BigInt    @map("patient_id")
  title            String    @db.VarChar(100)
  description      String    @db.Text
  date             String    @db.VarChar(50)
  imgUrl           String?   @map("img_url") @db.VarChar(255)
  patientName      String?   @map("patient_name") @db.VarChar(100)
  patientPhone     String?   @map("patient_phone") @db.VarChar(50)
  patientAddress   String?   @map("patient_address") @db.VarChar(255)
  registrationTime DateTime? @default(now()) @map("registration_time") @db.Timestamptz
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("medical_history")
}

model PatientDeposit {
  id              BigInt    @id @default(autoincrement())
  patientId       BigInt    @map("patient")
  depositedAmount Decimal   @map("deposited_amount") @db.Decimal(10, 2)
  date            String    @db.VarChar(50)
  user            String?   @db.VarChar(50)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("patient_deposit")
}

// =============================================================================
// 4. APPOINTMENTS, CLINICS & OPD SCHEDULING
// =============================================================================

model Doctor {
  id            BigInt    @id @default(autoincrement())
  name          String    @db.VarChar(100)
  email         String?   @db.VarChar(100)
  phone         String?   @db.VarChar(50)
  address       String?   @db.VarChar(255)
  department    String?   @db.VarChar(100)
  profile       String?   @db.Text
  imageUrl      String?   @map("img_url") @db.VarChar(255)
  x             String?   @default("") @db.VarChar(50)
  y             String?   @default("") @db.VarChar(50)
  ionUserId     String?   @map("ion_user_id") @db.VarChar(50)
  procedureId   String?   @map("procedure_id") @db.VarChar(100)
  sharePolicyId BigInt?   @map("share_policy_id")
  branchId      BigInt?   @map("branch_id")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  branch          HospitalBranch?   @relation(fields: [branchId], references: [id])
  appointments    Appointment[]
  slots           DoctorSlot[]
  slotBlocks      SlotBlock[]
  visitFees       VisitFee[]
  consultations   Consultation[]
  consultTemplates ConsultTemplate[]
  prescriptions   Prescription[]
  labOrders       Lab[]
  radiologyOrders RadiologyOrder[]
  doctorShares    DoctorShare[]
  invoiceItems    InvoiceItem[]
  pharmacyDispensations PharmacyDispensation[]
  attendingAdmissions   Admission[] @relation("AttendingDoctor")
  admittingAdmissions   Admission[] @relation("AdmittingDoctor")
  followUps             FollowUp[]
  criticalLabEscalations CriticalLabEscalation[]

  @@index([email])
  @@index([department])
  @@index([branchId])
  @@map("doctor")
}

model Appointment {
  id               BigInt    @id @default(autoincrement())
  patientId        BigInt    @map("patient")
  doctorId         BigInt    @map("doctor")
  date             String    @db.VarChar(50)
  timeSlot         String?   @map("time_slot") @db.VarChar(100)
  sTime            String    @map("s_time") @db.VarChar(50) // e.g. "2026-10-01 09:00:00"
  eTime            String    @map("e_time") @db.VarChar(50) // e.g. "2026-10-01 09:30:00"
  sTimeKey         String?   @map("s_time_key") @db.VarChar(50)
  status           String    @default("scheduled") @db.VarChar(50)
  remarks          String?   @db.Text
  addDate          String?   @map("add_date") @db.VarChar(50)
  registrationTime String?   @map("registration_time") @db.VarChar(50)
  user             String?   @default("") @db.VarChar(100)
  request          String?   @default("") @db.VarChar(100)
  bp               String?   @map("b_p") @db.VarChar(100)
  pulse            String?   @db.VarChar(100)
  temperature      String?   @map("temprature") @db.VarChar(100)
  weight           String?   @db.VarChar(100)
  tokenNo          Int?      @map("token_no")
  queueNumber      Int?      @map("queue_number")
  tokenNumber      String?   @map("token_number") @db.VarChar(50)
  visitType        String?   @default("first_visit") @map("visit_type") @db.VarChar(50)
  paymentId        BigInt?   @map("payment_id")
  mode             String    @default("in_person") @db.VarChar(20) // in_person or video
  videoRoom        String?   @map("video_room") @db.VarChar(100)
  branchId         BigInt?   @map("branch_id")
  checkedInAt      DateTime? @map("checked_in_at") @db.Timestamptz
  consultStartedAt DateTime? @map("consult_started_at") @db.Timestamptz
  calledInAt       DateTime? @map("called_in_at") @db.Timestamptz
  checkedOutAt     DateTime? @map("checked_out_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  priority         String    @default("NORMAL") @db.VarChar(20)
  cancellationReason String? @map("cancellation_reason") @db.Text
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz
  rescheduledFromId BigInt?  @map("rescheduled_from_id")
  rescheduleReason String?   @map("reschedule_reason") @db.Text
  department       String?   @db.VarChar(100)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient      Patient         @relation(fields: [patientId], references: [id])
  doctor       Doctor          @relation(fields: [doctorId], references: [id])
  branch       HospitalBranch? @relation(fields: [branchId], references: [id])
  payment      Payment?        @relation(fields: [paymentId], references: [id])
  consultation    Consultation?
  labs            Lab[]
  radiologyOrders RadiologyOrder[]

  @@index([doctorId, date])
  @@index([patientId])
  @@index([status])
  @@index([sTimeKey])
  @@index([branchId])
  @@map("appointment")
}

model DoctorSlot {
  id             BigInt          @id @default(autoincrement())
  doctorId       BigInt          @map("doctor_id")
  branchId       BigInt?         @map("branch_id")
  weekday        Int // 0=Sunday .. 6=Saturday
  startTime      String          @map("start_time") @db.VarChar(5) // HH:mm
  endTime        String          @map("end_time") @db.VarChar(5)   // HH:mm
  slotMinutes    Int             @default(15) @map("slot_minutes")
  breakStartTime String?         @map("break_start_time") @db.VarChar(5)
  breakEndTime   String?         @map("break_end_time") @db.VarChar(5)
  active         Boolean         @default(true)
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?       @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  doctor Doctor          @relation(fields: [doctorId], references: [id])
  branch HospitalBranch? @relation(fields: [branchId], references: [id])

  @@index([doctorId, weekday])
  @@index([branchId])
  @@map("doctor_slot")
}

model SlotBlock {
  id        BigInt          @id @default(autoincrement())
  doctorId  BigInt          @map("doctor_id")
  branchId  BigInt?         @map("branch_id")
  date      DateTime        @db.Date
  startTime String?         @map("start_time") @db.VarChar(5)
  endTime   String?         @map("end_time") @db.VarChar(5)
  reason    String?         @db.VarChar(255)
  createdAt DateTime?       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime?       @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  doctor Doctor          @relation(fields: [doctorId], references: [id])
  branch HospitalBranch? @relation(fields: [branchId], references: [id])

  @@index([doctorId, date])
  @@index([branchId])
  @@map("slot_block")
}

model VisitFee {
  id            BigInt       @id @default(autoincrement())
  doctorId      BigInt?      @map("doctor_id")
  visitType     String       @map("visit_type") @db.VarChar(20)
  patientTypeId BigInt?      @map("patient_type_id")
  amount        Decimal      @db.Decimal(10, 2)
  currency      String       @default("INR") @db.VarChar(3)
  active        Boolean      @default(true)
  createdAt     DateTime?    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime?    @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  doctor      Doctor?      @relation(fields: [doctorId], references: [id])
  patientType PatientType? @relation(fields: [patientTypeId], references: [id])

  @@index([doctorId])
  @@map("visit_fee")
}

model Holiday {
  id          BigInt    @id @default(autoincrement())
  date        String    @db.VarChar(50)
  title       String    @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@map("holidays")
}

// =============================================================================
// 5. CONSULTATIONS & PRESCRIPTIONS
// =============================================================================

model Consultation {
  id                   BigInt    @id @default(autoincrement())
  appointmentId        BigInt?   @unique @map("appointment_id")
  patientId            BigInt    @map("patient_id")
  doctorId             BigInt?   @map("doctor_id")
  date                 DateTime  @db.Date
  presentingComplaint  String?   @map("presenting_complaint") @db.Text
  history              String?   @db.Text
  examination          Json?     @db.JsonB // system => [status, note]
  provisionalDiagnosis String?   @map("provisional_diagnosis") @db.Text
  diagnosis            String?   @db.Text
  plan                 String?   @db.Text
  treatment            String?   @db.Text
  followUpDate         DateTime? @map("follow_up_date") @db.Date
  followUpNotes        String?   @map("follow_up_notes") @db.VarChar(255)
  allergies            String?   @db.Text
  pastHistory          Json?     @map("past_history") @db.JsonB
  socialHistory        Json?     @map("social_history") @db.JsonB
  specialty            Json?     @db.JsonB // gynae (with lmp, edd, gestational_age), dental, eye
  immunizations        Json?     @db.JsonB
  soapSubjective       String?   @map("soap_subjective") @db.Text
  soapObjective        String?   @map("soap_objective") @db.Text
  soapAssessment       String?   @map("soap_assessment") @db.Text
  soapPlan             String?   @map("soap_plan") @db.Text
  chiefComplaintDetails Json?   @map("chief_complaint_details") @db.JsonB
  hpiDetails           Json?     @map("hpi_details") @db.JsonB
  vitals               Json?     @db.JsonB
  diagnoses            Json?     @db.JsonB
  treatmentPlan        Json?     @map("treatment_plan") @db.JsonB
  signedAt             DateTime? @map("signed_at") @db.Timestamptz
  signedById           BigInt?   @map("signed_by_id")
  branchId             BigInt?   @map("branch_id")
  allergyStatus        String?   @default("UNKNOWN") @map("allergy_status") @db.VarChar(30)
  status               String    @default("draft") @db.VarChar(20) // draft, completed, signed
  completedAt          DateTime? @map("completed_at") @db.Timestamptz
  createdBy            BigInt?   @map("created_by")
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  doctor      Doctor?      @relation(fields: [doctorId], references: [id])
  signedBy    User?        @relation("ConsultationSigner", fields: [signedById], references: [id])
  branch      HospitalBranch? @relation(fields: [branchId], references: [id])
  amendments  ConsultationAmendment[]
  prescriptions   Prescription[]
  labs            Lab[]
  radiologyOrders RadiologyOrder[]
  invoices        Payment[]
  followUps       FollowUp[]

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([branchId])
  @@index([signedById])
  @@map("consultation")
}

model ConsultationAmendment {
  id             BigInt        @id @default(autoincrement())
  consultationId BigInt        @map("consultation_id")
  amendedBy      BigInt        @map("amended_by")
  reason         String        @db.Text
  amendedSection String        @map("amended_section") @db.VarChar(50)
  previousNotes  String?       @map("previous_notes") @db.Text
  newNotes       String        @map("new_notes") @db.Text
  createdAt      DateTime?     @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  consultation   Consultation  @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  amendedByUser  User          @relation("ConsultationAmendmentAuthor", fields: [amendedBy], references: [id])

  @@index([consultationId])
  @@index([amendedBy])
  @@map("consultation_amendment")
}

model ConsultTemplate {
  id        BigInt    @id @default(autoincrement())
  doctorId  BigInt?   @map("doctor_id")
  name      String    @db.VarChar(100)
  fields    Json      @db.JsonB
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  doctor Doctor? @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
  @@map("consult_template")
}

model Prescription {
  id                 BigInt    @id @default(autoincrement())
  prescriptionNumber String?   @unique @map("prescription_number") @db.VarChar(50)
  consultationId     BigInt?   @map("consultation_id")
  patientId          BigInt    @map("patient")
  doctorId           BigInt    @map("doctor")
  organizationId     BigInt?   @map("organization_id")
  branchId           BigInt?   @map("branch_id")
  date               String    @db.VarChar(50)
  symptom            String?   @db.Text
  advice             String?   @db.Text
  status             String    @default("DRAFT") @db.VarChar(30)
  signedAt           DateTime? @map("signed_at") @db.Timestamptz
  signedById         BigInt?   @map("signed_by_id")
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledById      BigInt?   @map("cancelled_by_id")
  cancellationReason String?   @map("cancellation_reason") @db.Text
  state              String?   @default("issued") @db.VarChar(50)
  dd                 String?   @db.VarChar(100)
  medicine           String?   @db.Text // Legacy summary string
  validity           String?   @db.VarChar(100)
  note               String?   @db.Text
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient       Patient                @relation(fields: [patientId], references: [id])
  doctor        Doctor                 @relation(fields: [doctorId], references: [id])
  consultation  Consultation?          @relation(fields: [consultationId], references: [id])
  organization  Organization?          @relation(fields: [organizationId], references: [id])
  branch        HospitalBranch?        @relation(fields: [branchId], references: [id])
  signedBy      User?                  @relation("PrescriptionSigner", fields: [signedById], references: [id])
  cancelledBy   User?                  @relation("PrescriptionCanceller", fields: [cancelledById], references: [id])
  medicines     PrescriptionMedicine[]
  dispensations PharmacyDispensation[]
  amendments    PrescriptionAmendment[]

  @@index([patientId])
  @@index([doctorId])
  @@index([consultationId])
  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@map("prescription")
}

model PrescriptionMedicine {
  id                BigInt  @id @default(autoincrement())
  prescriptionId    BigInt  @map("prescription_id")
  medicineId        BigInt? @map("medicine_id")
  name              String  @db.VarChar(200)
  dosage            String? @db.VarChar(100)
  duration          String? @db.VarChar(100)
  instructions      String? @db.VarChar(500)
  quantityPrescribed Int    @default(1) @map("quantity_prescribed")
  unit              String? @db.VarChar(30)
  route             String? @db.VarChar(50)
  frequency         String? @db.VarChar(50)
  timing            String? @db.VarChar(50)
  refills           Int     @default(0)
  startDate         String? @map("start_date") @db.VarChar(50)
  endDate           String? @map("end_date") @db.VarChar(50)
  dispensedQuantity Int     @default(0) @map("dispensed_quantity")

  // Relations
  prescription      Prescription               @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine          Medicine?                  @relation(fields: [medicineId], references: [id])
  dispensationItems PharmacyDispensationItem[]

  @@index([prescriptionId])
  @@index([medicineId])
  @@map("prescription_medicine")
}

model PrescriptionAmendment {
  id             BigInt        @id @default(autoincrement())
  prescriptionId BigInt        @map("prescription_id")
  amendedBy      BigInt        @map("amended_by")
  reason         String        @db.Text
  amendedSection String        @default("GENERAL") @map("amended_section") @db.VarChar(50)
  previousNotes  String?       @map("previous_notes") @db.Text
  newNotes       String        @map("new_notes") @db.Text
  createdAt      DateTime?     @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  prescription   Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  amendedByUser  User          @relation("PrescriptionAmendmentAuthor", fields: [amendedBy], references: [id])

  @@index([prescriptionId])
  @@index([amendedBy])
  @@map("prescription_amendment")
}

// =============================================================================
// 6. LABORATORY & RADIOLOGY DIAGNOSTICS
