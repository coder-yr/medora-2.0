// Medora 2.0 - Core Database Schema
// Platform: Supabase PostgreSQL
// ORM: Prisma ORM

datasource db {
  provider = "postgresql"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

// =============================================================================
// 1. IDENTITY, USERS & ACCESS CONTROL (RBAC)
// =============================================================================

enum UserGroup {
  ADMIN       @map("Admin")
  DOCTOR      @map("Doctor")
  NURSE       @map("Nurse")
  ACCOUNTANT  @map("Accountant")
  RECEPTIONIST @map("Receptionist")
  PHARMACIST  @map("Pharmacist")
  LABORATORIST @map("Laboratorist")
}

model User {
  id          BigInt     @id @default(autoincrement())
  uuid        String     @unique @default(uuid())
  firstName   String     @map("firstname") @db.VarChar(50)
  lastName    String     @map("lastname") @db.VarChar(50)
  login       String     @unique @db.VarChar(100)
  email       String     @default("") @db.VarChar(100)
  password    String     @db.VarChar(255)
  group       String     @db.VarChar(20)
  description String?    @map("desc") @db.VarChar(255)
  branchId    BigInt?    @map("branch_id")
  photo       String?    @db.VarChar(255)
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")
  isMfaEnabled Boolean   @default(false) @map("is_mfa_enabled")
  mfaSecret   String?    @map("mfa_secret") @db.VarChar(255)
  mfaRecoveryCodes Json?  @default("[]") @map("mfa_recovery_codes")
  createdAt   DateTime?  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime?  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  branch                 HospitalBranch?            @relation(fields: [branchId], references: [id])
  shiftCloses            ShiftClose[]
  assignedDrawers        CashDrawer[]               @relation("DrawerCashier")
  cashierShifts          CashierShift[]             @relation("CashierUser")
  approvedShifts         CashierShift[]             @relation("ShiftApprover")
  recordedCashTransactions CashTransaction[]         @relation("TransactionRecorder")
  reportedRadiologies    RadiologyOrder[]           @relation("ReportedRadiology")
  technologistRadiologies RadiologyOrder[]          @relation("TechnologistRadiology")
  verifiedRadiologies    RadiologyOrder[]           @relation("VerifiedRadiology")
  radiologyAmendments    RadiologyReportAmendment[]
  signedConsultations    Consultation[]             @relation("ConsultationSigner")
  consultationAmendments ConsultationAmendment[]   @relation("ConsultationAmendmentAuthor")
  signedPrescriptions    Prescription[]             @relation("PrescriptionSigner")
  cancelledPrescriptions Prescription[]             @relation("PrescriptionCanceller")
  prescriptionAmendments PrescriptionAmendment[]    @relation("PrescriptionAmendmentAuthor")
  enteredLabResults      LabResultParameter[]       @relation("LabResultEntry")
  sessions               UserSession[]
  staffProfile           StaffProfile?
  staffAssignmentsAssigned StaffDepartmentAssignment[] @relation("AssignmentAssigner")
  staffEmploymentEvents  StaffEmploymentHistory[]   @relation("HistoryRecorder")
  expensesCreated        Expense[]                  @relation("ExpenseCreator")
  expensesApproved       Expense[]                  @relation("ExpenseApprover")
  expensesPaid           Expense[]                  @relation("ExpensePayer")
  journalsCreated        JournalEntry[]             @relation("JournalCreator")
  journalsPosted         JournalEntry[]             @relation("JournalPoster")
  periodsClosed          AccountingPeriod[]         @relation("PeriodCloser")
  organizationId             BigInt?                    @map("organization_id")
  organization               Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationMemberships    UserOrganizationMembership[]
  orgSettingsUpdated         OrganizationSettings[]     @relation("OrgSettingsUpdater")
  assignedOrgMemberships     UserOrganizationMembership[] @relation("OrgMembershipAssigner")
  revokedOrgMemberships      UserOrganizationMembership[] @relation("OrgMembershipRevoker")
  branchMemberships          UserBranchMembership[]
  configurationAuditLogs     ConfigurationAuditLog[]
  hospitalSettingsUpdated    HospitalSettings[]         @relation("HospitalSettingsUpdater")
  branchSettingsUpdated      BranchSettings[]           @relation("BranchSettingsUpdater")
  branchMembershipsAssigned  UserBranchMembership[]     @relation("MembershipAssigner")
  branchMembershipsRevoked   UserBranchMembership[]     @relation("MembershipRevoker")
  notificationRecipients     NotificationRecipient[]
  notificationPreferences    NotificationPreference?
  platformAuditLogs          PlatformAuditLog[]         @relation("PlatformAuditActor")
  supportGrantsReceived      EmergencySupportGrant[]    @relation("SupportGrantRecipient")
  supportGrantsAuthorized    EmergencySupportGrant[]    @relation("SupportGrantAuthorizer")
  staffInvitationsAuthored   StaffInvitation[]          @relation("StaffInvitationAuthor")
  uploadedPatientDocuments   PatientDocument[]          @relation("DocumentUploader")
  registrationsApproved      OrganizationRegistration[] @relation("RegistrationApprover")
  registrationsRejected      OrganizationRegistration[] @relation("RegistrationRejector")
  onboardingsCompleted       OrganizationOnboarding[]   @relation("OnboardingCompleter")
  cancelledInvoices          Payment[]                  @relation("InvoiceCanceller")
  approvedRefunds            InvoiceRefund[]            @relation("InvoiceRefundApprover")
  processedRefunds           InvoiceRefund[]            @relation("InvoiceRefundProcessor")
  approvedPurchaseOrders     PurchaseOrder[]            @relation("PurchaseOrderApprover")
  createdPurchaseOrders      PurchaseOrder[]            @relation("PurchaseOrderCreator")
  sentStockTransfers         StockTransfer[]            @relation("TransfersSentByUser")
  receivedStockTransfers     StockTransfer[]            @relation("TransfersReceivedByUser")
  criticalLabEscalationsAcknowledged CriticalLabEscalation[] @relation("CriticalLabEscalationAcknowledgedBy")

  @@map("users")
}

model UserSession {
  id               BigInt    @id @default(autoincrement())
  uuid             String    @unique @default(uuid())
  userId           BigInt    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  familyId         String    @map("family_id") @db.VarChar(100)
  isRevoked        Boolean   @default(false) @map("is_revoked")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(50)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([familyId])
  @@map("user_sessions")
}

model Permission {
  id              BigInt   @id @default(autoincrement())
  permissionName  String   @map("permission_name") @db.VarChar(100)
  permissionGroup String   @map("permission_group") @db.VarChar(50)
  permissionType  String   @default("no") @map("permission_type") @db.VarChar(10) // 'yes' or 'no'

  @@unique([permissionName, permissionGroup])
  @@index([permissionGroup])
  @@map("permission")
}

// =============================================================================
// 2. ORGANIZATION, TENANCY & MULTI-BRANCH SETTINGS (PHASE 10.1)
// =============================================================================

enum OrganizationType {
  CLINIC
  POLYCLINIC
  DIAGNOSTIC_CENTER
  HOSPITAL
  HOSPITAL_NETWORK

  @@map("organization_type")
}

enum OrganizationStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  INACTIVE

  @@map("organization_status")
}

enum OrganizationEdition {
  CLINIC
  PROFESSIONAL
  HOSPITAL
  ENTERPRISE

  @@map("organization_edition")
}

model Organization {
  id                     BigInt               @id @default(autoincrement())
  name                   String               @db.VarChar(150)
  code                   String               @unique @db.VarChar(50)
  type                   OrganizationType     @default(HOSPITAL)
  status                 OrganizationStatus   @default(ACTIVE)
  edition                OrganizationEdition  @default(HOSPITAL)
  subscriptionTier       String?              @default("STANDARD") @map("subscription_tier") @db.VarChar(50)
  subscriptionExpiresAt  DateTime?            @map("subscription_expires_at") @db.Timestamptz
  maxBranches            Int                  @default(10) @map("max_branches")
  maxUsers               Int                  @default(100) @map("max_users")
  createdAt              DateTime?            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime?            @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?            @map("deleted_at") @db.Timestamptz

  // Relations
  settings               OrganizationSettings?
  branches               HospitalBranch[]
  users                  User[]
  userMemberships        UserOrganizationMembership[]
  hospitalSettings       HospitalSettings[]
  platformAuditLogs      PlatformAuditLog[]
  emergencySupportGrants EmergencySupportGrant[]
  staffInvitations       StaffInvitation[]
  registration           OrganizationRegistration?
  onboarding             OrganizationOnboarding?
  // Pharmacy & Inventory relations (Phase 10.4)
  medicineBatches        MedicineBatch[]
  stockMovements         StockMovement[]
  purchaseOrders         PurchaseOrder[]
  goodsReceipts          GoodsReceipt[]
  stockAdjustments       StockAdjustment[]
  pharmacyReturns        PharmacyReturn[]
  pharmacyDispensations  PharmacyDispensation[]
  prescriptions          Prescription[]
  labs                   Lab[]
  suppliers              Supplier[]
  // Billing & Finance relations (Phase 10.5.6)
  invoices               Payment[]
  invoicePayments        InvoicePayment[]
  paymentCategories      PaymentCategory[]
  invoiceRefunds         InvoiceRefund[]
  stockTransfers         StockTransfer[]
  notifications          Notification[]
  followUps              FollowUp[]

  @@map("organizations")
}

model OrganizationSettings {
  id                    BigInt         @id @default(autoincrement())
  organizationId        BigInt         @unique @map("organization_id")
  legalName             String?        @map("legal_name") @db.VarChar(150)
  registrationNumber    String?        @map("registration_number") @db.VarChar(50)
  taxNumber             String?        @map("tax_number") @db.VarChar(50)
  email                 String?        @db.VarChar(100)
  phone                 String?        @db.VarChar(50)
  website               String?        @db.VarChar(150)
  address               String?        @db.VarChar(255)
  defaultLocale         String         @default("en") @map("default_locale") @db.VarChar(10)
  defaultTimezone       String         @default("Asia/Kolkata") @map("default_timezone") @db.VarChar(50)
  defaultCurrency       String         @default("INR") @map("default_currency") @db.VarChar(10)
  dateFormat            String         @default("YYYY-MM-DD") @map("date_format") @db.VarChar(20)
  timeFormat            String         @default("HH:mm") @map("time_format") @db.VarChar(20)
  logoUrl               String?        @map("logo_url") @db.VarChar(500)
  faviconUrl            String?        @map("favicon_url") @db.VarChar(500)
  primaryColor          String         @default("#0284c7") @map("primary_color") @db.VarChar(10)
  secondaryColor        String         @default("#0f172a") @map("secondary_color") @db.VarChar(10)
  receiptHeader         String?        @map("receipt_header") @db.Text
  receiptFooter         String?        @map("receipt_footer") @db.Text
  invoiceFooter         String?        @map("invoice_footer") @db.Text
  enabledModules        Json?          @map("enabled_modules")
  createdAt             DateTime?      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime?      @updatedAt @map("updated_at") @db.Timestamptz
  updatedById           BigInt?        @map("updated_by_id")

  // Relations
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy             User?          @relation("OrgSettingsUpdater", fields: [updatedById], references: [id])

  @@map("organization_settings")
}

// =============================================================================
// 2b. ORGANIZATION REGISTRATION, APPROVAL & ONBOARDING (PHASE 10.3)
// =============================================================================

enum RegistrationStatus {
  DRAFT
  PENDING_EMAIL_VERIFICATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PROVISIONING
  ACTIVE
  SUSPENDED

  @@map("registration_status")
}

model OrganizationRegistration {
  id                         BigInt              @id @default(autoincrement())
  reference                  String              @unique @db.VarChar(50)
  status                     RegistrationStatus  @default(PENDING_EMAIL_VERIFICATION)

  // Organization Info
  organizationName           String              @map("organization_name") @db.VarChar(150)
  organizationType           OrganizationType    @default(HOSPITAL) @map("organization_type")
  requestedEdition           OrganizationEdition @default(HOSPITAL) @map("requested_edition")
  healthcareSpecialization   String?             @map("healthcare_specialization") @db.VarChar(100)
  licenseNumber              String?             @map("license_number") @db.VarChar(100)
  organizationEmail          String              @map("organization_email") @db.VarChar(100)
  contactPhone               String              @map("contact_phone") @db.VarChar(50)
  country                    String              @default("Pakistan") @db.VarChar(100)
  state                      String?             @db.VarChar(100)
  city                       String              @db.VarChar(100)
  address                    String?             @db.VarChar(255)
  postalCode                 String?             @map("postal_code") @db.VarChar(20)
  website                    String?             @db.VarChar(150)

  // Initial Admin Contact
  adminFullName              String              @map("admin_full_name") @db.VarChar(100)
  adminEmail                 String              @map("admin_email") @db.VarChar(100)
  adminPhone                 String?             @map("admin_phone") @db.VarChar(50)
  adminDesignation           String?             @map("admin_designation") @db.VarChar(100)

  // Email Verification (SHA-256 hash at rest)
  emailVerificationToken     String?             @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpiresAt DateTime?           @map("email_verification_expires_at") @db.Timestamptz
  isEmailVerified            Boolean             @default(false) @map("is_email_verified")
  emailVerifiedAt            DateTime?           @map("email_verified_at") @db.Timestamptz
  verificationAttempts       Int                 @default(0) @map("verification_attempts")
  lastVerificationSentAt     DateTime?           @map("last_verification_sent_at") @db.Timestamptz

  // Super Admin Approval / Review
  approvedById               BigInt?             @map("approved_by_id")
  approvedAt                 DateTime?           @map("approved_at") @db.Timestamptz
  rejectedById               BigInt?             @map("rejected_by_id")
  rejectedAt                 DateTime?           @map("rejected_at") @db.Timestamptz
  rejectionReason            String?             @map("rejection_reason") @db.Text
  approvedEdition            OrganizationEdition? @map("approved_edition")
  approvedModules            Json?               @default("[]") @map("approved_modules")

  // Provisioning
  organizationId             BigInt?             @unique @map("organization_id")
  provisionedAt              DateTime?           @map("provisioned_at") @db.Timestamptz
  provisioningError          String?             @map("provisioning_error") @db.Text

  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization               Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  approvedBy                 User?               @relation("RegistrationApprover", fields: [approvedById], references: [id])
  rejectedBy                 User?               @relation("RegistrationRejector", fields: [rejectedById], references: [id])

  @@index([status])
  @@index([organizationEmail])
  @@index([adminEmail])
  @@index([createdAt])
  @@map("organization_registrations")
}

model OrganizationOnboarding {
  id              BigInt       @id @default(autoincrement())
  organizationId  BigInt       @unique @map("organization_id")
  isCompleted     Boolean      @default(false) @map("is_completed")
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz
  completedById   BigInt?      @map("completed_by_id")
  currentStep     String       @default("profile") @map("current_step") @db.VarChar(50)
  checklist       Json         @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  completedBy     User?        @relation("OnboardingCompleter", fields: [completedById], references: [id])

  @@map("organization_onboardings")
}

model UserOrganizationMembership {
  id             BigInt         @id @default(autoincrement())
  userId         BigInt         @map("user_id")
  organizationId BigInt         @map("organization_id")
  isDefault      Boolean        @default(false) @map("is_default")
  isActive       Boolean        @default(true) @map("is_active")
  accessRole     String?        @map("access_role") @db.VarChar(50)
  assignedAt     DateTime       @default(now()) @map("assigned_at") @db.Timestamptz
  assignedById   BigInt?        @map("assigned_by_id")
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz
  revokedById    BigInt?        @map("revoked_by_id")
  notes          String?        @db.VarChar(255)

  // Relations
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedBy     User?          @relation("OrgMembershipAssigner", fields: [assignedById], references: [id])
  revokedBy      User?          @relation("OrgMembershipRevoker", fields: [revokedById], references: [id])

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_organization_memberships")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SUSPEND
  REACTIVATE
  LOGIN
  PASSWORD_RESET
  MEMBER_INVITE
  MEMBER_ROLE_CHANGE
  MEMBER_REVOKE
  PERMISSION_OVERRIDE
  EDITION_CHANGE
  ENTITLEMENT_TOGGLE
  BREAK_GLASS_ACCESS

  @@map("audit_action")
}

model PlatformAuditLog {
  id             BigInt       @id @default(autoincrement())
  action         String       @db.VarChar(50)
  targetType     String       @map("target_type") @db.VarChar(50)
  targetId       String?      @map("target_id") @db.VarChar(50)
  actorUserId    BigInt?      @map("actor_user_id")
  actorEmail     String?      @map("actor_email") @db.VarChar(100)
  actorRole      String?      @map("actor_role") @db.VarChar(50)
  organizationId BigInt?      @map("organization_id")
  details        Json?
  ipAddress      String?      @map("ip_address") @db.VarChar(50)
  userAgent      String?      @map("user_agent") @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  actorUser      User?        @relation("PlatformAuditActor", fields: [actorUserId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([actorUserId])
  @@index([organizationId])
  @@index([action])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

model EmergencySupportGrant {
  id              BigInt       @id @default(autoincrement())
  organizationId  BigInt       @map("organization_id")
  grantedToUserId BigInt       @map("granted_to_user_id")
  requestedReason String       @map("requested_reason") @db.VarChar(255)
  authorizedById  BigInt?      @map("authorized_by_id")
  expiresAt       DateTime     @map("expires_at") @db.Timestamptz
  isRevoked       Boolean      @default(false) @map("is_revoked")
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantedToUser   User         @relation("SupportGrantRecipient", fields: [grantedToUserId], references: [id])
  authorizedBy    User?        @relation("SupportGrantAuthorizer", fields: [authorizedById], references: [id])

  @@index([organizationId])
  @@index([grantedToUserId])
  @@map("emergency_support_grants")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}

model StaffInvitation {
  id             BigInt           @id @default(autoincrement())
  token          String           @unique @db.VarChar(100)
  email          String           @db.VarChar(100)
  name           String?          @db.VarChar(100)
  organizationId BigInt           @map("organization_id")
  branchId       BigInt?          @map("branch_id")
  role           String           @default("Doctor") @db.VarChar(50)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz
  invitedById    BigInt           @map("invited_by_id")
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         HospitalBranch?  @relation(fields: [branchId], references: [id])
  invitedBy      User             @relation("StaffInvitationAuthor", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("staff_invitations")
}

model HospitalBranch {
  id             BigInt         @id @default(autoincrement())
  organizationId BigInt?        @map("organization_id")
  name           String         @db.VarChar(100)
  code           String         @unique @db.VarChar(20)
  address        String?        @db.VarChar(255)
  phone          String?        @db.VarChar(50)
  active         Boolean        @default(true)
  createdAt      DateTime?      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz

  // Relations
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  users        User[]
  patients     Patient[]
  appointments Appointment[]
  doctors      Doctor[]
  beds         Bed[]
  admissions   Admission[]
  invoices     Payment[]
  cashDrawers  CashDrawer[]
  cashierShifts CashierShift[]
  staffProfiles StaffProfile[]
  staffDepartmentAssignments StaffDepartmentAssignment[]
  accounts     Account[]
  accountingPeriods AccountingPeriod[]
  journalEntries JournalEntry[]
  expenses     Expense[]
  settings            BranchSettings?
  userMemberships     UserBranchMembership[]
  auditLogs           ConfigurationAuditLog[]
  documentSequences   BranchDocumentSequence[]
  notifications       Notification[]
  staffInvitations    StaffInvitation[]
  // Pharmacy & Inventory relations (Phase 10.4)
  medicineBatches       MedicineBatch[]
  stockMovements        StockMovement[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  stockAdjustments      StockAdjustment[]
  pharmacyReturns       PharmacyReturn[]
  pharmacyDispensations PharmacyDispensation[]
  patientDocuments      PatientDocument[]
  doctorSlots           DoctorSlot[]
  slotBlocks            SlotBlock[]
  consultations         Consultation[]
  prescriptions         Prescription[]
  labs                  Lab[]
  // Billing & Finance relations (Phase 10.5.6)
  invoicePayments       InvoicePayment[]
  paymentCategories     PaymentCategory[]
  invoiceRefunds        InvoiceRefund[]
  sentTransfers         StockTransfer[]            @relation("TransfersSent")
  receivedTransfers     StockTransfer[]            @relation("TransfersReceived")
  followUps             FollowUp[]

  @@index([organizationId])
  @@map("hospital_branch")
}

model HospitalSettings {
  id                 BigInt        @id @default(autoincrement())
  organizationId     BigInt?       @map("organization_id")
  hospitalName       String        @map("hospital_name") @db.VarChar(150)
  legalName          String?       @map("legal_name") @db.VarChar(150)
  registrationNumber String?       @map("registration_number") @db.VarChar(50)
  taxNumber          String?       @map("tax_number") @db.VarChar(50)
  email              String?       @db.VarChar(100)
  phone              String?       @db.VarChar(50)
  alternatePhone     String?       @map("alternate_phone") @db.VarChar(50)
  website            String?       @db.VarChar(150)
  address            String?       @db.VarChar(255)
  defaultLocale      String        @default("en") @map("default_locale") @db.VarChar(10)
  defaultTimezone    String        @default("Asia/Kolkata") @map("default_timezone") @db.VarChar(50)
  defaultCurrency    String        @default("INR") @map("default_currency") @db.VarChar(10)
  dateFormat         String        @default("YYYY-MM-DD") @map("date_format") @db.VarChar(20)
  timeFormat         String        @default("HH:mm") @map("time_format") @db.VarChar(20)
  logoUrl            String?       @map("logo_url") @db.VarChar(500)
  faviconUrl         String?       @map("favicon_url") @db.VarChar(500)
  primaryColor       String        @default("#0284c7") @map("primary_color") @db.VarChar(10)
  secondaryColor     String        @default("#0f172a") @map("secondary_color") @db.VarChar(10)
  receiptHeader      String?       @map("receipt_header") @db.Text
  receiptFooter      String?       @map("receipt_footer") @db.Text
  invoiceFooter      String?       @map("invoice_footer") @db.Text
  createdAt          DateTime?     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime?     @updatedAt @map("updated_at") @db.Timestamptz
  updatedById        BigInt?       @map("updated_by_id")

  // Relations
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
