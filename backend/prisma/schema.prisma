model MedicineCategory {
  id          BigInt    @id @default(autoincrement())
  category    String    @db.VarChar(100)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  medicines Medicine[]

  @@map("medicine_category")
}

model Manufacturer {
  id           BigInt    @id @default(autoincrement())
  name         String    @unique @db.VarChar(100)
  country      String?   @db.VarChar(100)
  contactEmail String?   @map("contact_email") @db.VarChar(100)
  contactPhone String?   @map("contact_phone") @db.VarChar(50)
  address      String?   @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  medicines Medicine[]

  @@map("manufacturer")
}

model DosageForm {
  id          BigInt    @id @default(autoincrement())
  name        String    @unique @db.VarChar(50) // e.g. Tablet, Capsule, Syrup, Injection, Ointment, Drops
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  medicines Medicine[]

  @@map("dosage_form")
}

model MeasurementUnit {
  id        BigInt    @id @default(autoincrement())
  name      String    @unique @db.VarChar(50) // e.g. Milligram, Milliliter, Gram, Microgram, International Unit
  symbol    String    @db.VarChar(20)         // e.g. mg, ml, g, mcg, IU
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  medicines Medicine[]

  @@map("measurement_unit")
}

model Supplier {
  id            BigInt    @id @default(autoincrement())
  name          String    @db.VarChar(100)
  contactPerson String?   @map("contact_person") @db.VarChar(100)
  email         String?   @db.VarChar(100)
  phone         String?   @db.VarChar(50)
  address       String?   @db.Text
  gstin         String?   @db.VarChar(50)
  isActive      Boolean   @default(true) @map("is_active")
  organizationId BigInt?  @map("organization_id")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  medicines      Medicine[]
  batches        MedicineBatch[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  returns        PharmacyReturn[]

  @@index([organizationId])
  @@map("supplier")
}

model Medicine {
  id             BigInt    @id @default(autoincrement())
  name           String    @db.VarChar(100)
  brandName      String?   @map("brand_name") @db.VarChar(100)
  code           String?   @unique @map("code") @db.VarChar(50)
  composition    String?   @map("composition") @db.Text
  barcode        String?   @map("barcode") @db.VarChar(100)
  prescriptionRequired Boolean @default(true) @map("prescription_required")
  categoryId     BigInt?   @map("category")
  price          Decimal?  @default(0.00) @db.Decimal(10, 2) // Purchase / cost price
  box            String?   @db.VarChar(100) // Packaging / pack size format (e.g. 10x10 Tablets)
  sPrice         Decimal?  @map("s_price") @db.Decimal(10, 2) // Selling price
  quantity       Int       @default(0) // Inventory quantity on hand
  reorderLevel   Int       @default(10) @map("reorder_level")
  minStockLevel  Int       @default(5) @map("min_stock_level")
  maxStockLevel  Int       @default(1000) @map("max_stock_level")
  generic        String?   @db.VarChar(100)
  company        String?   @db.VarChar(100) // Legacy company / manufacturer string
  effects        String?   @db.Text
  expiryDate     String?   @map("e_date") @db.VarChar(50)
  isActive       Boolean   @default(true) @map("is_active")

  // Normalized relations
  manufacturerId BigInt?   @map("manufacturer_id")
  dosageFormId   BigInt?   @map("dosage_form_id")
  strength       String?   @db.VarChar(50)
  unitId         BigInt?   @map("unit_id")
  supplierId     BigInt?   @map("supplier_id")

  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  category             MedicineCategory?          @relation(fields: [categoryId], references: [id])
  manufacturer         Manufacturer?              @relation(fields: [manufacturerId], references: [id])
  dosageForm           DosageForm?                @relation(fields: [dosageFormId], references: [id])
  measurementUnit      MeasurementUnit?           @relation(fields: [unitId], references: [id])
  supplier             Supplier?                  @relation(fields: [supplierId], references: [id])
  prescriptionMedicines PrescriptionMedicine[]
  pharmacySaleItems    PharmacySaleItem[]
  batches              MedicineBatch[]
  stockMovements       StockMovement[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  dispensationItems    PharmacyDispensationItem[]
  adjustmentItems      StockAdjustmentItem[]
  returnItems          PharmacyReturnItem[]
  transfers            StockTransfer[]
  substitutedByItems   PharmacyDispensationItem[] @relation("SubstitutedOriginalMedicine")

  @@index([categoryId])
  @@index([manufacturerId])
  @@index([dosageFormId])
  @@index([unitId])
  @@index([supplierId])
  @@index([name])
  @@index([generic])
  @@map("medicine")
}

model PharmacyPayment {
  id             BigInt    @id @default(autoincrement())
  patientId      BigInt?   @map("patient")
  doctorId       BigInt?   @map("doctor")
  date           String    @db.VarChar(50)
  grossTotal     Decimal   @map("gross_total") @db.Decimal(10, 2)
  amountReceived Decimal   @map("amount_received") @db.Decimal(10, 2)
  discount       Decimal?  @default(0.00) @db.Decimal(10, 2)
  status         String    @default("unpaid") @db.VarChar(20)
  shiftCloseId   BigInt?   @map("shift_close_id")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  shiftClose ShiftClose?        @relation(fields: [shiftCloseId], references: [id])
  saleItems  PharmacySaleItem[]

  @@index([shiftCloseId])
  @@map("pharmacy_payment")
}

model PharmacySaleItem {
  id                BigInt  @id @default(autoincrement())
  pharmacyPaymentId BigInt  @map("pharmacy_payment_id")
  medicineId        BigInt  @map("medicine_id")
  medicineName      String  @map("medicine_name") @db.VarChar(100)
  quantity          Int
  unitPrice         Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice        Decimal @map("total_price") @db.Decimal(10, 2)

  // Relations
  pharmacyPayment PharmacyPayment @relation(fields: [pharmacyPaymentId], references: [id], onDelete: Cascade)
  medicine        Medicine        @relation(fields: [medicineId], references: [id])

  @@index([pharmacyPaymentId])
  @@map("pharmacy_sale_item")
}

// =============================================================================
// 7.1. BATCH INVENTORY, MOVEMENTS, PURCHASING & DISPENSING
// =============================================================================

model MedicineBatch {
  id              BigInt    @id @default(autoincrement())
  medicineId      BigInt    @map("medicine_id")
  batchNumber     String    @map("batch_number") @db.VarChar(100)
  mfgDate         String?   @map("mfg_date") @db.VarChar(50)
  expiryDate      DateTime  @map("expiry_date") @db.Date
  costPrice       Decimal   @map("cost_price") @db.Decimal(10, 2)
  sellingPrice    Decimal?  @map("selling_price") @db.Decimal(10, 2)
  initialQuantity Int       @map("initial_quantity")
  currentQuantity Int       @map("current_quantity")
  supplierId      BigInt?   @map("supplier_id")
  status          String    @default("ACTIVE") @db.VarChar(30) // ACTIVE, QUARANTINE, DEPLETED, EXPIRED, RECALLED
  notes           String?   @db.Text
  organizationId  BigInt?   @map("organization_id")
  branchId        BigInt?   @map("branch_id")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  medicine              Medicine                  @relation(fields: [medicineId], references: [id])
  organization          Organization?             @relation(fields: [organizationId], references: [id])
  branch                HospitalBranch?           @relation(fields: [branchId], references: [id])
  supplier              Supplier?                 @relation(fields: [supplierId], references: [id])
  stockMovements        StockMovement[]
  goodsReceiptItems     GoodsReceiptItem[]
  dispensationItems     PharmacyDispensationItem[]
  adjustmentItems       StockAdjustmentItem[]
  returnItems           PharmacyReturnItem[]
  transfers             StockTransfer[]

  @@unique([branchId, medicineId, batchNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([medicineId])
  @@index([expiryDate])
  @@index([status])
  @@index([supplierId])
  @@map("medicine_batch")
}

model StockMovement {
  id            BigInt    @id @default(autoincrement())
  medicineId    BigInt    @map("medicine_id")
  batchId       BigInt?   @map("batch_id")
  movementType  String    @map("movement_type") @db.VarChar(50) // PURCHASE_RECEIPT, DISPENSING, CUSTOMER_RETURN, SUPPLIER_RETURN, STOCK_ADJUSTMENT_IN, STOCK_ADJUSTMENT_OUT, EXPIRED_WRITE_OFF, DAMAGED_WRITE_OFF
  quantity      Int       // positive or negative
  balanceAfter  Int       @map("balance_after")
  unitCost      Decimal?  @map("unit_cost") @db.Decimal(10, 2)
  referenceType String?   @map("reference_type") @db.VarChar(50) // GOODS_RECEIPT, DISPENSATION, ADJUSTMENT, RETURN, INITIAL
  referenceId   BigInt?   @map("reference_id")
  performedBy   BigInt?   @map("performed_by")
  reason        String?   @db.Text
  organizationId BigInt?  @map("organization_id")
  branchId       BigInt?  @map("branch_id")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  medicine     Medicine        @relation(fields: [medicineId], references: [id])
  batch        MedicineBatch?  @relation(fields: [batchId], references: [id])
  organization Organization?   @relation(fields: [organizationId], references: [id])
  branch       HospitalBranch? @relation(fields: [branchId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([medicineId])
  @@index([batchId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("stock_movement")
}

model PurchaseOrder {
  id           BigInt              @id @default(autoincrement())
  poNumber     String              @unique @map("po_number") @db.VarChar(50)
  supplierId   BigInt              @map("supplier_id")
  orderDate    String              @map("order_date") @db.VarChar(50)
  expectedDate String?             @map("expected_date") @db.VarChar(50)
  totalAmount  Decimal             @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  status       String              @default("ORDERED") @db.VarChar(30) // DRAFT, ORDERED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  notes        String?             @db.Text
  createdById    BigInt?             @map("created_by_id")
  approvedById   BigInt?             @map("approved_by_id")
  approvedAt     DateTime?           @map("approved_at") @db.Timestamptz
  organizationId BigInt?           @map("organization_id")
  branchId       BigInt?           @map("branch_id")
  createdAt      DateTime?           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?           @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  createdBy      User?               @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  approvedBy     User?               @relation("PurchaseOrderApprover", fields: [approvedById], references: [id])
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  branch         HospitalBranch?     @relation(fields: [branchId], references: [id])
  items          PurchaseOrderItem[]
  goodsReceipts  GoodsReceipt[]

  @@index([organizationId])
  @@index([branchId])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id               BigInt              @id @default(autoincrement())
  purchaseOrderId  BigInt              @map("purchase_order_id")
  medicineId       BigInt              @map("medicine_id")
  quantityOrdered  Int                 @map("quantity_ordered")
  quantityReceived Int                 @default(0) @map("quantity_received")
  unitCost         Decimal             @map("unit_cost") @db.Decimal(10, 2)
  lineTotal        Decimal             @map("line_total") @db.Decimal(12, 2)

  // Relations
  purchaseOrder    PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicine         Medicine            @relation(fields: [medicineId], references: [id])
  receiptItems     GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([medicineId])
  @@map("purchase_order_item")
}

model GoodsReceipt {
  id                    BigInt             @id @default(autoincrement())
  receiptNumber         String             @unique @map("receipt_number") @db.VarChar(50)
  purchaseOrderId       BigInt?            @map("purchase_order_id")
  supplierId            BigInt             @map("supplier_id")
  receiptDate           String             @map("receipt_date") @db.VarChar(50)
  supplierInvoiceNumber String?            @map("supplier_invoice_number") @db.VarChar(100)
  totalAmount           Decimal            @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  notes                 String?            @db.Text
  receivedById          BigInt?            @map("received_by_id")
  organizationId        BigInt?            @map("organization_id")
  branchId              BigInt?            @map("branch_id")
  createdAt             DateTime?          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime?          @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  purchaseOrder         PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  supplier              Supplier           @relation(fields: [supplierId], references: [id])
  organization          Organization?      @relation(fields: [organizationId], references: [id])
  branch                HospitalBranch?    @relation(fields: [branchId], references: [id])
  items                 GoodsReceiptItem[]

  @@index([organizationId])
  @@index([branchId])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@map("goods_receipt")
}

model GoodsReceiptItem {
  id                  BigInt             @id @default(autoincrement())
  goodsReceiptId      BigInt             @map("goods_receipt_id")
  purchaseOrderItemId BigInt?            @map("purchase_order_item_id")
  medicineId          BigInt             @map("medicine_id")
  batchId             BigInt?            @map("batch_id")
  batchNumber         String             @map("batch_number") @db.VarChar(100)
  mfgDate             String?            @map("mfg_date") @db.VarChar(50)
  expiryDate          DateTime           @map("expiry_date") @db.Date
  quantityReceived    Int                @map("quantity_received")
  unitCost            Decimal            @map("unit_cost") @db.Decimal(10, 2)
  sellingPrice        Decimal?           @map("selling_price") @db.Decimal(10, 2)
  lineTotal           Decimal            @map("line_total") @db.Decimal(12, 2)

  // Relations
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  medicine            Medicine           @relation(fields: [medicineId], references: [id])
  batch               MedicineBatch?     @relation(fields: [batchId], references: [id])

  @@index([goodsReceiptId])
  @@index([medicineId])
  @@index([batchId])
  @@map("goods_receipt_item")
}

model PharmacyDispensation {
  id                 BigInt                     @id @default(autoincrement())
  dispensationNumber String                     @unique @map("dispensation_number") @db.VarChar(50)
  prescriptionId     BigInt?                    @map("prescription_id")
  patientId          BigInt?                    @map("patient_id")
  doctorId           BigInt?                    @map("doctor_id")
  patientName        String?                    @map("patient_name") @db.VarChar(100)
  dispenseDate       String                     @map("dispense_date") @db.VarChar(50)
  subtotal           Decimal                    @default(0.00) @db.Decimal(12, 2)
  discount           Decimal                    @default(0.00) @db.Decimal(12, 2)
  tax                Decimal                    @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal                    @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  status             String                     @default("COMPLETED") @db.VarChar(30) // COMPLETED, RETURNED, CANCELLED
  invoiceId          BigInt?                    @map("invoice_id")
  dispensedById      BigInt?                    @map("dispensed_by_id")
  admissionId        BigInt?                    @map("admission_id")
  notes              String?                    @db.Text
  organizationId     BigInt?                    @map("organization_id")
  branchId           BigInt?                    @map("branch_id")
  createdAt          DateTime?                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime?                  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  prescription       Prescription?              @relation(fields: [prescriptionId], references: [id])
  patient            Patient?                   @relation(fields: [patientId], references: [id])
  doctor             Doctor?                    @relation(fields: [doctorId], references: [id])
  invoice            Payment?                   @relation(fields: [invoiceId], references: [id])
  admission          Admission?                 @relation(fields: [admissionId], references: [id])
  organization       Organization?              @relation(fields: [organizationId], references: [id])
  branch             HospitalBranch?            @relation(fields: [branchId], references: [id])
  items              PharmacyDispensationItem[]
  returns            PharmacyReturn[]

  @@index([organizationId])
  @@index([branchId])
  @@index([prescriptionId])
  @@index([patientId])
  @@index([doctorId])
  @@index([invoiceId])
  @@index([dispenseDate])
  @@index([admissionId])
  @@map("pharmacy_dispensation")
}

model PharmacyDispensationItem {
  id                     BigInt                @id @default(autoincrement())
  dispensationId         BigInt                @map("dispensation_id")
  prescriptionMedicineId BigInt?               @map("prescription_medicine_id")
  medicineId             BigInt?               @map("medicine_id")
  batchId                BigInt?               @map("batch_id")
  medicineName           String                @map("medicine_name") @db.VarChar(200)
  batchNumber            String?               @map("batch_number") @db.VarChar(100)
  quantity               Int
  unitPrice              Decimal               @map("unit_price") @db.Decimal(10, 2)
  totalPrice             Decimal               @map("total_price") @db.Decimal(10, 2)
  returnedQuantity       Int                   @default(0) @map("returned_quantity")
  isSubstituted          Boolean               @default(false) @map("is_substituted")
  originalMedicineId     BigInt?               @map("original_medicine_id")
  substitutionReason     String?               @map("substitution_reason") @db.VarChar(255)

  // Relations
  dispensation           PharmacyDispensation  @relation(fields: [dispensationId], references: [id], onDelete: Cascade)
  prescriptionMedicine   PrescriptionMedicine? @relation(fields: [prescriptionMedicineId], references: [id])
  medicine               Medicine?             @relation(fields: [medicineId], references: [id])
  originalMedicine       Medicine?             @relation("SubstitutedOriginalMedicine", fields: [originalMedicineId], references: [id])
  batch                  MedicineBatch?        @relation(fields: [batchId], references: [id])
  returnItems            PharmacyReturnItem[]

  @@index([dispensationId])
  @@index([prescriptionMedicineId])
  @@index([medicineId])
  @@index([batchId])
  @@map("pharmacy_dispensation_item")
}

model StockAdjustment {
  id               BigInt                @id @default(autoincrement())
  adjustmentNumber String                @unique @map("adjustment_number") @db.VarChar(50)
  adjustmentDate   String                @map("adjustment_date") @db.VarChar(50)
  reason           String                @db.VarChar(100) // PHYSICAL_COUNT, DAMAGED, EXPIRED, AUDIT_CORRECTION, OTHER
  status           String                @default("APPROVED") @db.VarChar(30) // PENDING, APPROVED, REJECTED
  adjustedById     BigInt?               @map("adjusted_by_id")
  approvedById     BigInt?               @map("approved_by_id")
  notes            String?               @db.Text
  organizationId   BigInt?               @map("organization_id")
  branchId         BigInt?               @map("branch_id")
  createdAt        DateTime?             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime?             @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization     Organization?         @relation(fields: [organizationId], references: [id])
  branch           HospitalBranch?       @relation(fields: [branchId], references: [id])
  items            StockAdjustmentItem[]

  @@index([organizationId])
  @@index([branchId])
  @@index([adjustmentDate])
  @@index([status])
  @@map("stock_adjustment")
}

model StockAdjustmentItem {
  id               BigInt          @id @default(autoincrement())
  adjustmentId     BigInt          @map("adjustment_id")
  medicineId       BigInt          @map("medicine_id")
  batchId          BigInt          @map("batch_id")
  systemQuantity   Int             @map("system_quantity")
  physicalQuantity Int             @map("physical_quantity")
  difference       Int             // physical - system (can be positive or negative)
  unitCost         Decimal?        @map("unit_cost") @db.Decimal(10, 2)

  // Relations
  adjustment       StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  medicine         Medicine        @relation(fields: [medicineId], references: [id])
  batch            MedicineBatch   @relation(fields: [batchId], references: [id])

  @@index([adjustmentId])
  @@index([medicineId])
  @@index([batchId])
  @@map("stock_adjustment_item")
}

model PharmacyReturn {
  id                 BigInt                @id @default(autoincrement())
  returnNumber       String                @unique @map("return_number") @db.VarChar(50)
  returnType         String                @map("return_type") @db.VarChar(30) // PATIENT_RETURN, SUPPLIER_RETURN
  dispensationId     BigInt?               @map("dispensation_id")
  supplierId         BigInt?               @map("supplier_id")
  returnDate         String                @map("return_date") @db.VarChar(50)
  reason             String                @db.Text
  totalRefund        Decimal               @default(0.00) @map("total_refund") @db.Decimal(12, 2)
  restockToInventory Boolean               @default(true) @map("restock_to_inventory")
  processedById      BigInt?               @map("processed_by_id")
  organizationId     BigInt?               @map("organization_id")
  branchId           BigInt?               @map("branch_id")
  createdAt          DateTime?             @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  dispensation       PharmacyDispensation? @relation(fields: [dispensationId], references: [id])
  supplier           Supplier?             @relation(fields: [supplierId], references: [id])
  organization       Organization?         @relation(fields: [organizationId], references: [id])
  branch             HospitalBranch?       @relation(fields: [branchId], references: [id])
  items              PharmacyReturnItem[]

  @@index([organizationId])
  @@index([branchId])
  @@index([dispensationId])
  @@index([supplierId])
  @@index([returnType])
  @@map("pharmacy_return")
}

model PharmacyReturnItem {
  id                 BigInt                    @id @default(autoincrement())
  returnId           BigInt                    @map("return_id")
  dispensationItemId BigInt?                   @map("dispensation_item_id")
  medicineId         BigInt                    @map("medicine_id")
  batchId            BigInt                    @map("batch_id")
  quantity           Int
  unitPrice          Decimal                   @map("unit_price") @db.Decimal(10, 2)
  totalRefund        Decimal                   @map("total_refund") @db.Decimal(12, 2)
  condition          String                    @default("SALEABLE") @db.VarChar(30) // SALEABLE, DAMAGED, EXPIRED

  // Relations
  return             PharmacyReturn            @relation(fields: [returnId], references: [id], onDelete: Cascade)
  dispensationItem   PharmacyDispensationItem? @relation(fields: [dispensationItemId], references: [id])
  medicine           Medicine                  @relation(fields: [medicineId], references: [id])
  batch              MedicineBatch             @relation(fields: [batchId], references: [id])

  @@index([returnId])
  @@index([dispensationItemId])
  @@index([medicineId])
  @@index([batchId])
  @@map("pharmacy_return_item")
}

model StockTransfer {
  id              BigInt          @id @default(autoincrement())
  transferNumber  String          @unique @map("transfer_number") @db.VarChar(50)
  fromBranchId    BigInt          @map("from_branch_id")
  toBranchId      BigInt          @map("to_branch_id")
  medicineId      BigInt          @map("medicine_id")
  batchId         BigInt          @map("batch_id")
  quantity        Int
  status          String          @default("COMPLETED") @db.VarChar(30) // PENDING, COMPLETED, CANCELLED
  transferredById BigInt?         @map("transferred_by_id")
  receivedById    BigInt?         @map("received_by_id")
  reason          String?         @db.Text
  organizationId  BigInt?         @map("organization_id")
  createdAt       DateTime?       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime?       @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  fromBranch      HospitalBranch  @relation("TransfersSent", fields: [fromBranchId], references: [id])
  toBranch        HospitalBranch  @relation("TransfersReceived", fields: [toBranchId], references: [id])
  medicine        Medicine        @relation(fields: [medicineId], references: [id])
  batch           MedicineBatch   @relation(fields: [batchId], references: [id])
  transferredBy   User?           @relation("TransfersSentByUser", fields: [transferredById], references: [id])
  receivedBy      User?           @relation("TransfersReceivedByUser", fields: [receivedById], references: [id])
  organization    Organization?   @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([medicineId])
  @@index([batchId])
  @@index([status])
  @@map("stock_transfer")
}

// =============================================================================
// 8. BILLING, INVOICES & CASH BALANCING
// =============================================================================

model PaymentCategory {
  id             BigInt          @id @default(autoincrement())
  category       String          @db.VarChar(100) // Service Name
  code           String?         @db.VarChar(50)
  description    String?         @db.Text
  cPrice         Decimal         @map("c_price") @db.Decimal(10, 2) // Default list price
  dCommission    Decimal?        @map("d_commission") @db.Decimal(5, 2) // Default share %
  kind           String          @default("misc") @db.VarChar(20) // consultation, procedure, lab, etc.
  taxRate        Decimal?        @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  active         Boolean         @default(true)
  organizationId BigInt?         @map("organization_id")
  branchId       BigInt?         @map("branch_id")
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?       @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  branch         HospitalBranch? @relation(fields: [branchId], references: [id])
  servicePrices  ServicePrice[]
  invoiceItems   InvoiceItem[]
  radiologyExams RadiologyExam[]

  @@index([organizationId])
  @@index([branchId])
  @@index([code])
  @@map("payment_category")
}

model ServicePrice {
  id                BigInt    @id @default(autoincrement())
  paymentCategoryId BigInt    @map("payment_category_id")
  patientTypeId     BigInt    @map("patient_type_id")
  opdPrice          Decimal?  @map("opd_price") @db.Decimal(10, 2)
  ipdPrice          Decimal?  @map("ipd_price") @db.Decimal(10, 2)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  paymentCategory PaymentCategory @relation(fields: [paymentCategoryId], references: [id], onDelete: Cascade)
  patientType     PatientType     @relation(fields: [patientTypeId], references: [id], onDelete: Cascade)

  @@unique([paymentCategoryId, patientTypeId])
  @@map("service_price")
}

model Payment {
  id              BigInt    @id @default(autoincrement())
  invoiceNumber   String?   @unique @map("invoice_number") @db.VarChar(50)
  organizationId  BigInt?   @map("organization_id")
  patientId       BigInt    @map("patient")
  doctor          String?   @db.VarChar(100)
  referringDoctor String?   @map("referring_doctor") @db.VarChar(100)
  date            String    @db.VarChar(50)
  dueDate         DateTime? @map("due_date") @db.Timestamptz
  amount          Decimal   @default(0.00) @db.Decimal(12, 2) // Subtotal
  grossTotal      Decimal   @map("gross_total") @db.Decimal(12, 2) // Subtotal - discount + vat
  amountReceived  Decimal   @default(0.00) @map("amount_received") @db.Decimal(12, 2)
  discount        Decimal?  @default(0.00) @db.Decimal(12, 2)
  vat             Decimal?  @default(0.00) @db.Decimal(12, 2)
  status          String    @default("unpaid") @db.VarChar(20) // paid, part paid, unpaid, DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED, REFUNDED
  patientTypeId   BigInt?   @map("patient_type_id")
  careSetting     String    @default("opd") @map("care_setting") @db.VarChar(10) // opd, ipd
  shiftCloseId    BigInt?   @map("shift_close_id")
  branchId        BigInt?   @map("branch_id")
  consultationId  BigInt?   @map("consultation_id")
  labOrderId      BigInt?   @map("lab_order_id")
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledById   BigInt?   @map("cancelled_by_id")
  cancellationReason String? @map("cancellation_reason") @db.Text
  remarks         String?   @db.Text
  doctorName      String?   @map("doctor_name") @db.VarChar(100)
  user            String?   @db.VarChar(100)
  dateString      String?   @map("date_string") @db.VarChar(50)
  patientName     String?   @map("patient_name") @db.VarChar(100)
  patientPhone    String?   @map("patient_phone") @db.VarChar(50)
  patientAddress  String?   @map("patient_address") @db.VarChar(255)
  category        String?   @db.VarChar(255)
  categoryName    String?   @map("category_name") @db.VarChar(1000)
  categoryAmount  String?   @map("category_amount") @db.VarChar(1000)
  admissionId     BigInt?   @map("admission_id")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  patient         Patient          @relation(fields: [patientId], references: [id])
  patientType     PatientType?     @relation(fields: [patientTypeId], references: [id])
  branch          HospitalBranch?  @relation(fields: [branchId], references: [id])
  consultation    Consultation?    @relation(fields: [consultationId], references: [id])
  cancelledBy     User?            @relation("InvoiceCanceller", fields: [cancelledById], references: [id])
  shiftClose      ShiftClose?      @relation(fields: [shiftCloseId], references: [id])
  admission       Admission?       @relation(fields: [admissionId], references: [id])
  inpatientFolios InpatientFolio[]
  items           InvoiceItem[]
  payments        InvoicePayment[]
  refunds         InvoiceRefund[]
  appointments    Appointment[]
  doctorShares    DoctorShare[]
  radiologyOrders RadiologyOrder[]
  pharmacyDispensations PharmacyDispensation[]
  labs            Lab[]
  cashTransactions CashTransaction[]

  @@index([patientId])
  @@index([organizationId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([shiftCloseId])
  @@index([admissionId])
  @@index([consultationId])
  @@map("payment")
}

model InvoiceItem {
  id                BigInt   @id @default(autoincrement())
  paymentId         BigInt   @map("payment_id")
  paymentCategoryId BigInt?  @map("payment_category_id")
  name              String   @db.VarChar(200)
  quantity          Int      @default(1)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 2)
  taxRate           Decimal? @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount         Decimal? @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  discount          Decimal? @default(0.00) @db.Decimal(12, 2)
  lineTotal         Decimal  @map("line_total") @db.Decimal(12, 2)
  doctorId          BigInt?  @map("doctor_id")

  // Relations
  payment         Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentCategory PaymentCategory? @relation(fields: [paymentCategoryId], references: [id])
  doctor          Doctor?          @relation(fields: [doctorId], references: [id])
  doctorShares    DoctorShare[]

  @@index([paymentId])
  @@map("invoice_item")
}

model InvoicePayment {
  id              BigInt    @id @default(autoincrement())
  receiptNumber   String?   @unique @map("receipt_number") @db.VarChar(50)
  organizationId  BigInt?   @map("organization_id")
  branchId        BigInt?   @map("branch_id")
  paymentId       BigInt    @map("payment_id")
  date            String?   @db.VarChar(50)
  amount          Decimal   @db.Decimal(12, 2)
  refundedAmount  Decimal   @default(0.00) @map("refunded_amount") @db.Decimal(12, 2)
  status          String    @default("COMPLETED") @db.VarChar(20) // COMPLETED, PARTIALLY_REFUNDED, REFUNDED, VOID
  method          String?   @default("Cash") @db.VarChar(60) // Cash, UPI, Card, Bank transfer, Cheque, Online, Write-off
  reference       String?   @db.VarChar(120)
  paidAt          String?   @map("paid_at") @db.VarChar(100)
  receivedBy      BigInt?   @map("received_by")
  shiftCloseId    BigInt?   @map("shift_close_id")
  shiftId         BigInt?   @map("shift_id")
  user            String?   @db.VarChar(50)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  branch           HospitalBranch?  @relation(fields: [branchId], references: [id])
  payment          Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  shiftClose       ShiftClose?      @relation(fields: [shiftCloseId], references: [id])
  shift            CashierShift?    @relation(fields: [shiftId], references: [id])
  refunds          InvoiceRefund[]
  cashTransactions CashTransaction[]

  @@index([paymentId])
  @@index([receiptNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([shiftCloseId])
  @@index([shiftId])
  @@map("invoice_payment")
}

model InvoiceRefund {
  id               BigInt          @id @default(autoincrement())
  refundNumber     String          @unique @map("refund_number") @db.VarChar(50)
  paymentId        BigInt          @map("payment_id") // Invoice
  invoicePaymentId BigInt?         @map("invoice_payment_id") // Original receipt
  organizationId   BigInt?         @map("organization_id")
  branchId         BigInt?         @map("branch_id")
  amount           Decimal         @db.Decimal(12, 2)
  reason           String          @db.Text
  method           String          @default("Cash") @db.VarChar(50)
  approvedById     BigInt?         @map("approved_by_id")
  processedById    BigInt          @map("processed_by_id")
  refundedAt       DateTime        @default(now()) @map("refunded_at") @db.Timestamptz
  createdAt        DateTime?       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime?       @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  payment          Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoicePayment   InvoicePayment? @relation(fields: [invoicePaymentId], references: [id])
  organization     Organization?   @relation(fields: [organizationId], references: [id])
  branch           HospitalBranch? @relation(fields: [branchId], references: [id])
  approvedBy       User?           @relation("InvoiceRefundApprover", fields: [approvedById], references: [id])
  processedBy      User            @relation("InvoiceRefundProcessor", fields: [processedById], references: [id])
  cashTransactions CashTransaction[]

  @@index([paymentId])
  @@index([invoicePaymentId])
  @@index([organizationId])
  @@index([branchId])
  @@index([refundedAt])
  @@map("invoice_refund")
}

model ShiftClose {
  id                BigInt    @id @default(autoincrement())
  userId            BigInt    @map("user_id")
  closedAt          DateTime  @map("closed_at") @db.Timestamptz
  expectedCash      Decimal   @map("expected_cash") @db.Decimal(12, 2)
  countedCash       Decimal   @map("counted_cash") @db.Decimal(12, 2)
  discrepancy       Decimal   @db.Decimal(12, 2)
  bankTransferTotal Decimal   @default(0.00) @map("bank_transfer_total") @db.Decimal(12, 2)
  cardTotal         Decimal   @default(0.00) @map("card_total") @db.Decimal(12, 2)
  chequeTotal       Decimal   @default(0.00) @map("cheque_total") @db.Decimal(12, 2)
  otherTotal        Decimal   @default(0.00) @map("other_total") @db.Decimal(12, 2)
  writeOffTotal     Decimal   @default(0.00) @map("write_off_total") @db.Decimal(12, 2)
  notes             String?   @db.Text
  status            String    @default("closed") @db.VarChar(20) // closed, verified
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user             User              @relation(fields: [userId], references: [id])
  invoices         Payment[]
  invoicePayments  InvoicePayment[]
  pharmacyPayments PharmacyPayment[]

  @@index([userId])
  @@map("shift_close")
}

// =============================================================================
// 8.1 CASHIER, SHIFT & TREASURY MANAGEMENT
// =============================================================================

model CashDrawer {
  id                BigInt         @id @default(autoincrement())
  name              String         @db.VarChar(100)
  code              String         @unique @db.VarChar(50)
  branchId          BigInt?        @map("branch_id")
  assignedCashierId BigInt?        @map("assigned_cashier_id")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime?      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime?      @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  branch            HospitalBranch? @relation(fields: [branchId], references: [id])
  assignedCashier   User?           @relation("DrawerCashier", fields: [assignedCashierId], references: [id])
  shifts            CashierShift[]

  @@map("cash_drawer")
}

model CashierShift {
  id              BigInt                   @id @default(autoincrement())
  shiftNumber     String                   @unique @map("shift_number") @db.VarChar(50)
  cashierId       BigInt                   @map("cashier_id")
  branchId        BigInt?                  @map("branch_id")
  cashDrawerId    BigInt?                  @map("cash_drawer_id")
  openedAt        DateTime                 @default(now()) @map("opened_at") @db.Timestamptz
  closedAt        DateTime?                @map("closed_at") @db.Timestamptz
  openingCash     Decimal                  @default(0.00) @map("opening_cash") @db.Decimal(12, 2)
  expectedCash    Decimal                  @default(0.00) @map("expected_cash") @db.Decimal(12, 2)
  countedCash     Decimal?                 @map("counted_cash") @db.Decimal(12, 2)
  cashVariance    Decimal?                 @map("cash_variance") @db.Decimal(12, 2)
  status          String                   @default("OPEN") @db.VarChar(20) // OPEN, CLOSING, PENDING_APPROVAL, CLOSED, REJECTED
  approvedBy      BigInt?                  @map("approved_by")
  approvedAt      DateTime?                @map("approved_at") @db.Timestamptz
  rejectionReason String?                  @map("rejection_reason") @db.Text
  closingNotes    String?                  @map("closing_notes") @db.Text
  createdAt       DateTime?                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime?                @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  cashier         User                     @relation("CashierUser", fields: [cashierId], references: [id])
  approver        User?                    @relation("ShiftApprover", fields: [approvedBy], references: [id])
  branch          HospitalBranch?          @relation(fields: [branchId], references: [id])
  cashDrawer      CashDrawer?              @relation(fields: [cashDrawerId], references: [id])
  transactions    CashTransaction[]
  denominations   ShiftCloseDenomination[]
  invoicePayments InvoicePayment[]

  @@index([cashierId])
  @@index([status])
  @@index([branchId])
  @@map("cashier_shift")
}

model CashTransaction {
  id                BigInt          @id @default(autoincrement())
  shiftId           BigInt          @map("shift_id")
  transactionNumber String          @unique @map("transaction_number") @db.VarChar(50)
  transactionType   String          @map("transaction_type") @db.VarChar(30) // PAYMENT_RECEIVED, REFUND, CASH_PAYOUT, OPENING_FLOAT, CASH_ADJUSTMENT, REVERSAL
  paymentId         BigInt?         @map("payment_id")
  invoicePaymentId  BigInt?         @map("invoice_payment_id")
  refundId          BigInt?         @map("refund_id")
  sourceModule      String          @default("INVOICE") @map("source_module") @db.VarChar(30) // INVOICE, PHARMACY, LABORATORY, RADIOLOGY, INPATIENT_FOLIO, DIRECT, MANUAL
  sourceReference   String?         @map("source_reference") @db.VarChar(100)
  idempotencyKey    String?         @unique @map("idempotency_key") @db.VarChar(100)
  paymentMethod     String          @default("Cash") @map("payment_method") @db.VarChar(50)
  amount            Decimal         @db.Decimal(12, 2)
  isCash            Boolean         @default(true) @map("is_cash")
  direction         String          @default("INFLOW") @db.VarChar(10) // INFLOW, OUTFLOW
  recordedBy        BigInt          @map("recorded_by")
  occurredAt        DateTime        @default(now()) @map("occurred_at") @db.Timestamptz
  reversalReference String?         @map("reversal_reference") @db.VarChar(100)
  notes             String?         @db.Text
  createdAt         DateTime?       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime?       @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  shift             CashierShift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  payment           Payment?        @relation(fields: [paymentId], references: [id])
  invoicePayment    InvoicePayment? @relation(fields: [invoicePaymentId], references: [id])
  refund            InvoiceRefund?  @relation(fields: [refundId], references: [id])
  recorder          User            @relation("TransactionRecorder", fields: [recordedBy], references: [id])

  @@index([shiftId])
  @@index([paymentId])
  @@index([refundId])
  @@index([transactionType])
  @@index([occurredAt])
  @@map("cash_transaction")
}

model ShiftCloseDenomination {
  id           BigInt       @id @default(autoincrement())
  shiftId      BigInt       @map("shift_id")
  denomination Decimal      @db.Decimal(10, 2)
  count        Int          @default(0)
  totalAmount  Decimal      @map("total_amount") @db.Decimal(12, 2)
  createdAt    DateTime?    @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  shift        CashierShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@map("shift_close_denomination")
}


// =============================================================================
// 9. DOCTOR REVENUE SHARE
// =============================================================================

model DoctorShare {
  id            BigInt    @id @default(autoincrement())
  paymentId     BigInt    @map("payment_id")
  invoiceItemId BigInt?   @map("invoice_item_id")
  doctorId      BigInt    @map("doctor_id")
  shareRuleId   BigInt?   @map("share_rule_id")
  role          String    @default("performing") @db.VarChar(20) // performing or referring
  baseAmount    Decimal   @map("base_amount") @db.Decimal(10, 2)
  percent       Decimal?  @map("percent") @db.Decimal(5, 2)
  amount        Decimal   @map("amount") @db.Decimal(10, 2)
  status        String    @default("pending") @db.VarChar(20) // pending, approved, paid
  approvedBy    BigInt?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz
  payoutRef     String?   @map("payout_ref") @db.VarChar(50)
  paidAt        DateTime? @map("paid_at") @db.Timestamptz
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  doctor      Doctor       @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
  @@index([status])
  @@map("doctor_share")
}

// =============================================================================
// 10. GENERAL ACCOUNTING, CHART OF ACCOUNTS & EXPENSE LEDGER (PHASE 20)
// =============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum AccountingPeriodStatus {
  OPEN
  CLOSING
  CLOSED
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model Account {
  id                 BigInt        @id @default(autoincrement())
  accountCode        String        @unique @map("account_code") @db.VarChar(50)
  accountName        String        @map("account_name") @db.VarChar(150)
  description        String?       @db.Text
  accountType        AccountType   @map("account_type")
  accountSubType     String?       @map("account_sub_type") @db.VarChar(100)
  normalBalance      NormalBalance @map("normal_balance")
  parentAccountId    BigInt?       @map("parent_account_id")
  isSystemAccount    Boolean       @default(false) @map("is_system_account")
  isActive           Boolean       @default(true) @map("is_active")
  allowManualPosting Boolean       @default(true) @map("allow_manual_posting")
  currency           String        @default("INR") @db.VarChar(10)
  branchId           BigInt?       @map("branch_id")
  createdAt          DateTime?     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime?     @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  parentAccount      Account?      @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts      Account[]     @relation("AccountHierarchy")
  branch             HospitalBranch? @relation(fields: [branchId], references: [id])
  journalLines       JournalEntryLine[]
  expenseCategories  ExpenseCategory[]

  @@index([accountCode])
  @@index([accountType])
  @@index([parentAccountId])
  @@index([branchId])
  @@index([isActive])
  @@map("accounting_account")
}

model AccountingPeriod {
  id           BigInt                 @id @default(autoincrement())
  periodCode   String                 @unique @map("period_code") @db.VarChar(50)
  name         String                 @db.VarChar(100)
  startDate    DateTime               @map("start_date") @db.Date
  endDate      DateTime               @map("end_date") @db.Date
  status       AccountingPeriodStatus @default(OPEN)
  branchId     BigInt?                @map("branch_id")
  closedAt     DateTime?              @map("closed_at") @db.Timestamptz
  closedBy     BigInt?                @map("closed_by")
  closingNotes String?                @map("closing_notes") @db.Text
  createdAt    DateTime?              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime?              @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  branch         HospitalBranch? @relation(fields: [branchId], references: [id])
  closer         User?           @relation("PeriodCloser", fields: [closedBy], references: [id])
  journalEntries JournalEntry[]

  @@index([periodCode])
  @@index([status])
  @@index([startDate, endDate])
  @@map("accounting_period")
}

model JournalEntry {
  id              BigInt         @id @default(autoincrement())
  journalNumber   String         @unique @map("journal_number") @db.VarChar(50)
  accountingDate  DateTime       @map("accounting_date") @db.Date
  description     String         @db.Text
  referenceType   String?        @map("reference_type") @db.VarChar(50)
  referenceId     String?        @map("reference_id") @db.VarChar(100)
  sourceModule    String         @default("MANUAL") @map("source_module") @db.VarChar(50)
  sourceReference String?        @map("source_reference") @db.VarChar(100)
  idempotencyKey  String?        @unique @map("idempotency_key") @db.VarChar(150)
  status          JournalStatus  @default(DRAFT)
  totalDebit      Decimal        @map("total_debit") @db.Decimal(14, 2)
  totalCredit     Decimal        @map("total_credit") @db.Decimal(14, 2)
  branchId        BigInt?        @map("branch_id")
  periodId        BigInt?        @map("period_id")
  createdById     BigInt         @map("created_by_id")
  postedById      BigInt?        @map("posted_by_id")
  postedAt        DateTime?      @map("posted_at") @db.Timestamptz
  reversedEntryId BigInt?        @unique @map("reversed_entry_id")
  reversalReason  String?        @map("reversal_reason") @db.Text
  createdAt       DateTime?      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime?      @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  branch          HospitalBranch?   @relation(fields: [branchId], references: [id])
  period          AccountingPeriod? @relation(fields: [periodId], references: [id])
  creator         User              @relation("JournalCreator", fields: [createdById], references: [id])
  poster          User?             @relation("JournalPoster", fields: [postedById], references: [id])
  reversedEntry   JournalEntry?     @relation("JournalReversal", fields: [reversedEntryId], references: [id])
  reversalBy      JournalEntry?     @relation("JournalReversal")
  lines           JournalEntryLine[]
  expenses        Expense[]

  @@index([journalNumber])
  @@index([accountingDate])
  @@index([status])
  @@index([sourceModule])
  @@index([referenceType, referenceId])
  @@map("accounting_journal_entry")
}

model JournalEntryLine {
  id             BigInt       @id @default(autoincrement())
  journalEntryId BigInt       @map("journal_entry_id")
  accountId      BigInt       @map("account_id")
  lineNumber     Int          @default(1) @map("line_number")
  debit          Decimal      @default(0.00) @db.Decimal(14, 2)
  credit         Decimal      @default(0.00) @db.Decimal(14, 2)
  description    String?      @db.VarChar(255)
  branchId       BigInt?      @map("branch_id")
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("accounting_journal_line")
}

model ExpenseCategory {
  id          BigInt     @id @default(autoincrement())
  code        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(100)
  description String?    @db.Text
  accountId   BigInt?    @map("account_id")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime?  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime?  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  account     Account?   @relation(fields: [accountId], references: [id])
  expenses    Expense[]

  @@index([code])
  @@index([isActive])
  @@map("accounting_expense_category")
}

model Expense {
  id                   BigInt         @id @default(autoincrement())
  expenseNumber        String         @unique @map("expense_number") @db.VarChar(50)
  categoryId           BigInt         @map("category_id")
  description          String         @db.Text
  amount               Decimal        @db.Decimal(14, 2)
  expenseDate          DateTime       @map("expense_date") @db.Date
  vendorName           String?        @map("vendor_name") @db.VarChar(150)
  invoiceNumber        String?        @map("invoice_number") @db.VarChar(100)
  paymentMethod        String         @default("CASH") @map("payment_method") @db.VarChar(50)
  status               ExpenseStatus  @default(DRAFT)
  branchId             BigInt?        @map("branch_id")
  createdById          BigInt         @map("created_by_id")
  approvedById         BigInt?        @map("approved_by_id")
  approvedAt           DateTime?      @map("approved_at") @db.Timestamptz
  rejectionReason      String?        @map("rejection_reason") @db.Text
  paidAt               DateTime?      @map("paid_at") @db.Timestamptz
  paidById             BigInt?        @map("paid_by_id")
  postedJournalEntryId BigInt?        @map("posted_journal_entry_id")
  notes                String?        @db.Text
  createdAt            DateTime?      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime?      @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  category             ExpenseCategory @relation(fields: [categoryId], references: [id])
  branch               HospitalBranch? @relation(fields: [branchId], references: [id])
  creator              User            @relation("ExpenseCreator", fields: [createdById], references: [id])
  approver             User?           @relation("ExpenseApprover", fields: [approvedById], references: [id])
  payer                User?           @relation("ExpensePayer", fields: [paidById], references: [id])
  postedJournalEntry   JournalEntry?   @relation(fields: [postedJournalEntryId], references: [id])

  @@index([expenseNumber])
  @@index([status])
  @@index([expenseDate])
  @@index([categoryId])
  @@index([createdById])
  @@map("accounting_expense")
}

model AccountingSetting {
  id          BigInt    @id @default(autoincrement())
  key         String    @unique @db.VarChar(100)
  value       String    @db.Text
  description String?   @db.VarChar(255)
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@map("accounting_setting")
}

model AccountingLegacy {
  id          BigInt    @id @default(autoincrement())
  name        String?   @db.VarChar(255)
  sector      String?   @db.VarChar(255)
  category    String?   @db.VarChar(50)
  description String?   @db.Text
  amount      Decimal?  @db.Decimal(12, 2)
  date        String?   @db.VarChar(50)
  receiptNo   String?   @map("receipt_no") @db.VarChar(100)
  userId      BigInt?   @map("user_id")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@map("accounting")
}

model AccountSectorLegacy {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(255)
  type      String    @db.VarChar(50)
  status    String?   @default("active") @db.VarChar(50)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@map("accounting_sector")
}

// =============================================================================
// 19. NOTIFICATIONS, MESSAGING & BACKGROUND JOBS (PHASE 22)
// =============================================================================

model Notification {
  id                 BigInt                   @id @default(autoincrement())
  uuid               String                   @unique @default(uuid())
  eventType          String                   @map("event_type") @db.VarChar(50)
  channel            String                   @db.VarChar(20) // 'IN_APP' | 'EMAIL' | 'SMS'
  title              String                   @db.VarChar(200)
  message            String                   @db.Text
  metadata           Json?
  priority           String                   @default("NORMAL") @db.VarChar(20) // 'LOW' | 'NORMAL' | 'HIGH' | 'URGENT'
  status             String                   @default("PENDING") @db.VarChar(20) // 'PENDING' | 'PROCESSING' | 'DELIVERED' | 'FAILED' | 'CANCELLED'
  organizationId     BigInt?                  @map("organization_id")
  branchId           BigInt?                  @map("branch_id")
  scheduledAt        DateTime?                @map("scheduled_at") @db.Timestamptz
  sentAt             DateTime?                @map("sent_at") @db.Timestamptz
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization       Organization?            @relation(fields: [organizationId], references: [id])
  branch             HospitalBranch?          @relation(fields: [branchId], references: [id])
  recipients         NotificationRecipient[]
  deliveries         NotificationDelivery[]
  outbox             NotificationOutbox?

  @@index([organizationId])
  @@index([eventType])
  @@index([channel, status])
  @@index([branchId])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationRecipient {
  id             BigInt        @id @default(autoincrement())
  notificationId BigInt        @map("notification_id")
  userId         BigInt?       @map("user_id")
  patientId      BigInt?       @map("patient_id")
  destination    String?       @db.VarChar(150) // Phone number or email
  recipientName  String?       @map("recipient_name") @db.VarChar(100)
  isRead         Boolean       @default(false) @map("is_read")
  readAt         DateTime?     @map("read_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  notification   Notification  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient        Patient?      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([userId, isRead])
  @@index([patientId])
  @@map("notification_recipients")
}

model NotificationTemplate {
  id          BigInt    @id @default(autoincrement())
  templateKey String    @map("template_key") @db.VarChar(100)
  channel     String    @db.VarChar(20) // 'IN_APP' | 'EMAIL' | 'SMS'
  locale      String    @default("en") @db.VarChar(10)
  subject     String?   @db.VarChar(200)
  body        String    @db.Text
  variables   Json?
  isActive    Boolean   @default(true) @map("is_active")
  version     Int       @default(1)
  branchId    BigInt?   @map("branch_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([templateKey, channel, locale])
  @@index([templateKey])
  @@map("notification_templates")
}

model NotificationPreference {
  id                  BigInt    @id @default(autoincrement())
  userId              BigInt?   @unique @map("user_id")
  patientId           BigInt?   @unique @map("patient_id")
  inAppEnabled        Boolean   @default(true) @map("in_app_enabled")
  emailEnabled        Boolean   @default(true) @map("email_enabled")
  smsEnabled          Boolean   @default(true) @map("sms_enabled")
  appointmentConsent  Boolean   @default(true) @map("appointment_consent")
  labConsent          Boolean   @default(true) @map("lab_consent")
  followUpConsent     Boolean   @default(true) @map("follow_up_consent")
  billingConsent      Boolean   @default(true) @map("billing_consent")
  consentGivenAt      DateTime? @map("consent_given_at") @db.Timestamptz
  consentSource       String?   @map("consent_source") @db.VarChar(50)
  preferredChannel    String    @default("IN_APP") @map("preferred_channel") @db.VarChar(20)
  channelOverrides    Json?     @map("channel_overrides")
  quietHoursStart     String?   @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd       String?   @map("quiet_hours_end") @db.VarChar(5)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient          Patient?  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationOutbox {
  id                  BigInt        @id @default(autoincrement())
  notificationId      BigInt        @unique @map("notification_id")
  channel             String        @db.VarChar(20)
  status              String        @default("PENDING") @db.VarChar(20) // 'PENDING' | 'PROCESSING' | 'DELIVERED' | 'RETRYABLE' | 'DEAD_LETTER' | 'CANCELLED'
  attempts            Int           @default(0)
  maxAttempts         Int           @default(5) @map("max_attempts")
  scheduledAt         DateTime      @default(now()) @map("scheduled_at") @db.Timestamptz
  nextRetryAt         DateTime?     @map("next_retry_at") @db.Timestamptz
  processingStartedAt DateTime?     @map("processing_started_at") @db.Timestamptz
  lastError           String?       @map("last_error") @db.Text
  lastErrorCategory   String?       @map("last_error_category") @db.VarChar(50) // 'TRANSIENT' | 'PERMANENT' | 'TIMEOUT' | 'RATE_LIMITED'
  deduplicationKey    String?       @unique @map("deduplication_key") @db.VarChar(150)
  deliveredAt         DateTime?     @map("delivered_at") @db.Timestamptz
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  notification        Notification  @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([status, nextRetryAt])
  @@map("notification_outbox")
}

model NotificationDelivery {
  id                BigInt        @id @default(autoincrement())
  notificationId    BigInt        @map("notification_id")
  channel           String        @db.VarChar(20)
  provider          String        @db.VarChar(50)
  providerMessageId String?       @map("provider_message_id") @db.VarChar(150)
  attemptNumber     Int           @map("attempt_number")
  status            String        @db.VarChar(20) // 'SUCCESS' | 'TRANSIENT_FAILURE' | 'PERMANENT_FAILURE'
  statusCode        String?       @map("status_code") @db.VarChar(50)
  responseBody      String?       @map("response_body") @db.Text
  errorMessage      String?       @map("error_message") @db.Text
  durationMs        Int?          @map("duration_ms")
  sentAt            DateTime      @default(now()) @map("sent_at") @db.Timestamptz

  // Relations
  notification      Notification  @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@index([notificationId])
  @@index([provider, status])
  @@index([sentAt])
  @@map("notification_deliveries")
}

// =============================================================================
// 20. CLINICAL FOLLOW-UPS & CRITICAL ESCALATIONS (PHASE 10.5.8)
// =============================================================================

model FollowUp {
  id                   BigInt          @id @default(autoincrement())
  uuid                 String          @unique @default(uuid())
  followUpNumber       String          @unique @map("follow_up_number") @db.VarChar(30)
  organizationId       BigInt          @map("organization_id")
  branchId             BigInt          @map("branch_id")
  patientId            BigInt          @map("patient_id")
  doctorId             BigInt          @map("doctor_id")
  consultationId       BigInt?         @map("consultation_id")
  dueDate              DateTime        @map("due_date") @db.Date
  dueTime              String?         @map("due_time") @db.VarChar(10)
  reason               String          @db.VarChar(255)
  priority             String          @default("ROUTINE") @db.VarChar(20) // 'ROUTINE' | 'URGENT' | 'CRITICAL'
  status               String          @default("SCHEDULED") @db.VarChar(20) // 'SCHEDULED' | 'REMINDER_PENDING' | 'REMINDER_SENT' | 'COMPLETED' | 'CANCELLED' | 'MISSED'
  clinicalNotes        String?         @map("clinical_notes") @db.Text
  reminderPreference   String          @default("IN_APP") @map("reminder_preference") @db.VarChar(20) // 'IN_APP' | 'EMAIL' | 'SMS' | 'NONE'
  reminderScheduledAt  DateTime?       @map("reminder_scheduled_at") @db.Timestamptz
  reminderSentAt       DateTime?       @map("reminder_sent_at") @db.Timestamptz
  completedAt          DateTime?       @map("completed_at") @db.Timestamptz
  cancelledAt          DateTime?       @map("cancelled_at") @db.Timestamptz
  cancellationReason   String?         @map("cancellation_reason") @db.VarChar(255)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization         Organization    @relation(fields: [organizationId], references: [id])
  branch               HospitalBranch  @relation(fields: [branchId], references: [id])
  patient              Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor               Doctor          @relation(fields: [doctorId], references: [id])
  consultation         Consultation?   @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([organizationId, branchId])
  @@index([patientId])
  @@index([doctorId])
  @@index([status, dueDate])
  @@map("follow_ups")
}

model CriticalLabEscalation {
  id                      BigInt          @id @default(autoincrement())
  labOrderId              BigInt          @map("lab_order_id")
  labReportId             BigInt?         @map("lab_report_id")
  patientId               BigInt          @map("patient_id")
  responsibleClinicianId  BigInt?         @map("responsible_clinician_id")
  criticalFindings        String          @map("critical_findings") @db.Text
  isAcknowledged          Boolean         @default(false) @map("is_acknowledged")
  acknowledgedAt          DateTime?       @map("acknowledged_at") @db.Timestamptz
  acknowledgedById        BigInt?         @map("acknowledged_by_id")
  acknowledgementNotes    String?         @map("acknowledgement_notes") @db.Text
  escalatedAt             DateTime        @default(now()) @map("escalated_at") @db.Timestamptz
  disclaimer              String          @default("Electronic notification does not replace direct verbal clinical handoff.") @map("disclaimer") @db.VarChar(255)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  labOrder                Lab             @relation(fields: [labOrderId], references: [id], onDelete: Restrict)
  patient                 Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  responsibleClinician    Doctor?         @relation(fields: [responsibleClinicianId], references: [id], onDelete: SetNull)
  acknowledgedBy          User?           @relation("CriticalLabEscalationAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([labOrderId])
  @@index([patientId])
  @@index([isAcknowledged])
  @@map("critical_lab_escalations")
}
