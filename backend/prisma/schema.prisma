  dateOfBirth           DateTime?      @map("date_of_birth") @db.Date
  nationalId            String?        @map("national_id") @db.VarChar(50) // CNIC / National ID
  email                 String?        @db.VarChar(100)
  phone                 String?        @db.VarChar(50)
  alternatePhone        String?        @map("alternate_phone") @db.VarChar(50)
  address               String?        @db.VarChar(255)
  emergencyContactName  String?        @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactPhone String?        @map("emergency_contact_phone") @db.VarChar(50)
  joiningDate           DateTime       @default(now()) @map("joining_date") @db.Date
  employmentType        String         @default("FULL_TIME") @map("employment_type") @db.VarChar(50) // FULL_TIME, PART_TIME, CONTRACT, PROBATION, VISITING, INTERN
  employmentStatus      String         @default("ACTIVE") @map("employment_status") @db.VarChar(50) // ACTIVE, ON_LEAVE, SUSPENDED, INACTIVE, TERMINATED
  departmentId          BigInt?        @map("department_id")
  designationId         BigInt?        @map("designation_id")
  branchId              BigInt?        @map("branch_id")
  reportingManagerId    BigInt?        @map("reporting_manager_id")
  profileImage          String?        @map("profile_image") @db.VarChar(255)
  qualifications        String?        @db.Text
  offboardedAt          DateTime?      @map("offboarded_at") @db.Timestamptz
  offboardingReason     String?        @map("offboarding_reason") @db.Text
  createdAt             DateTime?      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime?      @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user                  User?          @relation(fields: [userId], references: [id])
  department            Department?    @relation(fields: [departmentId], references: [id])
  designation           StaffDesignation? @relation(fields: [designationId], references: [id])
  branch                HospitalBranch? @relation(fields: [branchId], references: [id])
  reportingManager      StaffProfile?  @relation("StaffHierarchy", fields: [reportingManagerId], references: [id])
  directReports         StaffProfile[] @relation("StaffHierarchy")
  departmentAssignments StaffDepartmentAssignment[]
  employmentHistory     StaffEmploymentHistory[]

  @@index([employeeNumber])
  @@index([departmentId])
  @@index([designationId])
  @@index([branchId])
  @@index([employmentStatus])
  @@index([email])
  @@index([phone])
  @@map("staff_profile")
}

model StaffDepartmentAssignment {
  id             BigInt        @id @default(autoincrement())
  staffProfileId BigInt        @map("staff_profile_id")
  departmentId   BigInt        @map("department_id")
  branchId       BigInt?       @map("branch_id")
  isPrimary      Boolean       @default(true) @map("is_primary")
  effectiveStart DateTime      @default(now()) @map("effective_start") @db.Date
  effectiveEnd   DateTime?     @map("effective_end") @db.Date
  reason         String?       @db.VarChar(255)
  assignedBy     BigInt?       @map("assigned_by")
  createdAt      DateTime?     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?     @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  staffProfile   StaffProfile   @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
