// Medora 2.0 - Core Database Schema
// Platform: Supabase PostgreSQL
// ORM: Prisma ORM

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// 1. IDENTITY, USERS & ACCESS CONTROL (RBAC)
// =============================================================================

enum UserGroup {
  ADMIN       @map("Admin")
  DOCTOR      @map("Doctor")
  NURSE       @map("Nurse")
  ACCOUNTANT  @map("Accountant")
  RECEPTIONIST @map("Receptionist")
  PHARMACIST  @map("Pharmacist")
  LABORATORIST @map("Laboratorist")
}

model User {
  id          BigInt     @id @default(autoincrement())
  uuid        String     @unique @default(uuid())
  firstName   String     @map("firstname") @db.VarChar(50)
  lastName    String     @map("lastname") @db.VarChar(50)
  login       String     @unique @db.VarChar(100)
  email       String     @default("") @db.VarChar(100)
  password    String     @db.VarChar(255)
  group       String     @db.VarChar(20)
  description String?    @map("desc") @db.VarChar(255)
  branchId    BigInt?    @map("branch_id")
  photo       String?    @db.VarChar(255)
  createdAt   DateTime?  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime?  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  branch                 HospitalBranch?            @relation(fields: [branchId], references: [id])
  shiftCloses            ShiftClose[]
  reportedRadiologies    RadiologyOrder[]           @relation("ReportedRadiology")
  technologistRadiologies RadiologyOrder[]          @relation("TechnologistRadiology")
  verifiedRadiologies    RadiologyOrder[]           @relation("VerifiedRadiology")
  radiologyAmendments    RadiologyReportAmendment[]
  sessions               UserSession[]

  @@map("users")
}

model UserSession {
  id               BigInt    @id @default(autoincrement())
  uuid             String    @unique @default(uuid())
  userId           BigInt    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  familyId         String    @map("family_id") @db.VarChar(100)
  isRevoked        Boolean   @default(false) @map("is_revoked")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(50)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([familyId])
  @@map("user_sessions")
}

model Permission {
  id              BigInt   @id @default(autoincrement())
  permissionName  String   @map("permission_name") @db.VarChar(100)
  permissionGroup String   @map("permission_group") @db.VarChar(50)
  permissionType  String   @default("no") @map("permission_type") @db.VarChar(10) // 'yes' or 'no'

  @@unique([permissionName, permissionGroup])
  @@index([permissionGroup])
  @@map("permission")
}

// =============================================================================
// 2. MULTI-BRANCH & HOSPITAL SETTINGS
// =============================================================================

model HospitalBranch {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(100)
  code      String    @unique @db.VarChar(20)
  address   String?   @db.VarChar(255)
  phone     String?   @db.VarChar(50)
  active    Boolean   @default(true)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  users        User[]
  patients     Patient[]
  appointments Appointment[]
  doctors      Doctor[]
  beds         Bed[]
  admissions   Admission[]
  invoices     Payment[]

  @@map("hospital_branch")
}

model Institute {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(100)
  establish String?   @db.VarChar(10)
  email     String?   @db.VarChar(100)
  web       String?   @db.VarChar(100)
  phoneNo   String?   @map("phoneNo") @db.VarChar(50)
  address   String?   @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@map("institute")
}

model Department {
  id          BigInt    @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(1000)
  x           String?   @default("") @db.VarChar(50)
  y           String?   @default("") @db.VarChar(50)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@map("department")
}

// =============================================================================
// 3. PATIENTS & INPATIENT WARDS
// =============================================================================

model PatientType {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(50)
  slug        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  active      Boolean   @default(true)
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patients      Patient[]
  servicePrices ServicePrice[]
  invoices      Payment[]
  visitFees     VisitFee[]

  @@map("patient_type")
}

model Patient {
  id               BigInt    @id @default(autoincrement())
  patientId        String?   @unique @map("patient_id") @db.VarChar(100) // Format: 000001
  name             String    @db.VarChar(100)
  email            String?   @db.VarChar(100)
  phone            String?   @db.VarChar(100)
  address          String?   @db.VarChar(255)
  birthdate        String?   @db.VarChar(100)
  age              String?   @db.VarChar(100)
  sex              String?   @db.VarChar(50)
  bloodGroup       String?   @map("bloodgroup") @db.VarChar(50)
  patientTypeId    BigInt?   @map("patient_type_id")
  cnic             String?   @db.VarChar(50)
  fatherName       String?   @map("father_name") @db.VarChar(100)
  guardianRelation String?   @map("guardian_relation") @db.VarChar(50)
  guardianMrn      String?   @map("guardian_mrn") @db.VarChar(50)
  mlc              Boolean   @default(false)
  oldMrn           String?   @map("old_mrn") @db.VarChar(50)
  employeeNo       String?   @map("employee_no") @db.VarChar(50)
  altPhone         String?   @map("alt_phone") @db.VarChar(50)
  city             String?   @db.VarChar(100)
  branchId         BigInt?   @map("branch_id")
  imageUrl         String?   @map("img_url") @db.VarChar(255)
  attendingDoctor  String?   @map("doctor") @db.VarChar(100)
  addDate          String?   @map("add_date") @db.VarChar(100)
  registrationTime String?   @map("registration_time") @db.VarChar(100)
  ionUserId        String?   @map("ion_user_id") @db.VarChar(100)
  howAdded         String?   @map("how_added") @db.VarChar(100)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patientType      PatientType?      @relation(fields: [patientTypeId], references: [id])
  branch           HospitalBranch?   @relation(fields: [branchId], references: [id])
  appointments     Appointment[]
  allotedBeds      AllotedBed[]
  medicalHistories MedicalHistory[]
  consultations    Consultation[]
  prescriptions    Prescription[]
  labOrders        Lab[]
  radiologyOrders  RadiologyOrder[]
  invoices         Payment[]
  patientDeposits  PatientDeposit[]
  pharmacyDispensations PharmacyDispensation[]
  admissions       Admission[]
  inpatientFolios  InpatientFolio[]

  @@index([patientTypeId])
  @@index([branchId])
  @@index([cnic])
  @@index([phone])
  @@index([oldMrn])
  @@map("patient")
}

model BedCategory {
  id          BigInt    @id @default(autoincrement())
  category    String    @db.VarChar(100) // Ward Name (e.g. General Ward, ICU)
  code        String?   @db.VarChar(50)  // Ward Code (e.g. GW-01, ICU-A)
  description String?   @db.Text
  baseRate    Decimal   @default(0.00) @map("base_rate") @db.Decimal(10, 2)
  billingUnit String    @default("DAILY") @map("billing_unit") @db.VarChar(20)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  beds        Bed[]
  admissions  Admission[]

  @@map("bed_category")
}

model Bed {
  id          BigInt    @id @default(autoincrement())
  categoryId  BigInt    @map("category")
  number      String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  status      String    @default("AVAILABLE") @db.VarChar(50)
  isActive    Boolean   @default(true) @map("is_active")
  branchId    BigInt?   @map("branch_id")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  category    BedCategory          @relation(fields: [categoryId], references: [id])
  branch      HospitalBranch?      @relation(fields: [branchId], references: [id])
  allotedBeds AllotedBed[]
  admissions  Admission[]
  allocations BedAllocationHistory[]

  @@unique([categoryId, number])
  @@index([branchId])
  @@index([status])
  @@map("bed")
}

model AllotedBed {
  id          BigInt    @id @default(autoincrement())
  patientId   BigInt    @map("patient")
  bedId       BigInt    @map("bed_id")
  aTime       String    @map("a_time") @db.VarChar(100) // Admission time
  dTime       String?   @map("d_time") @db.VarChar(100) // Discharge time (NULL = currently occupied)
  category    String?   @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient     Patient   @relation(fields: [patientId], references: [id])
  bed         Bed       @relation(fields: [bedId], references: [id])

  @@index([patientId])
  @@index([bedId])
  @@index([dTime])
  @@map("alloted_bed")
}

model Admission {
  id                    BigInt    @id @default(autoincrement())
  admissionNumber       String    @unique @map("admission_number") @db.VarChar(50)
  patientId             BigInt    @map("patient_id")
  attendingDoctorId     BigInt?   @map("attending_doctor_id")
  admittingDoctorId     BigInt?   @map("admitting_doctor_id")
  wardId                BigInt    @map("ward_id")
  bedId                 BigInt    @map("bed_id")
  admissionDate         DateTime  @map("admission_date") @db.Timestamptz
  expectedDischargeDate DateTime? @map("expected_discharge_date") @db.Timestamptz
  actualDischargeDate   DateTime? @map("actual_discharge_date") @db.Timestamptz
  admissionType         String    @default("ELECTIVE") @map("admission_type") @db.VarChar(50) // EMERGENCY, ELECTIVE, TRANSFER, URGENT
  admissionReason       String?   @map("admission_reason") @db.Text
  diagnosis             String?   @db.Text
  clinicalNotes         String?   @map("clinical_notes") @db.Text
  status                String    @default("ADMITTED") @db.VarChar(50) // PENDING, ADMITTED, TRANSFERRED, DISCHARGE_PENDING, DISCHARGED, CANCELLED
  dischargeSummary      String?   @map("discharge_summary") @db.Text
  dischargeCondition    String?   @map("discharge_condition") @db.VarChar(100) // RECOVERED, IMPROVED, UNCHANGED, REFERRED, DECEASED, LAMA
  createdBy             BigInt?   @map("created_by")
  dischargedBy          BigInt?   @map("discharged_by")
  branchId              BigInt?   @map("branch_id")
  createdAt             DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient               Patient                 @relation(fields: [patientId], references: [id])
  attendingDoctor       Doctor?                 @relation("AttendingDoctor", fields: [attendingDoctorId], references: [id])
  admittingDoctor       Doctor?                 @relation("AdmittingDoctor", fields: [admittingDoctorId], references: [id])
  ward                  BedCategory             @relation(fields: [wardId], references: [id])
  bed                   Bed                     @relation(fields: [bedId], references: [id])
  branch                HospitalBranch?         @relation(fields: [branchId], references: [id])
  allocations           BedAllocationHistory[]
  folio                 InpatientFolio?
  pharmacyDispensations PharmacyDispensation[]
  labOrders             Lab[]
  radiologyOrders       RadiologyOrder[]
  invoices              Payment[]

  @@index([patientId])
  @@index([bedId])
  @@index([wardId])
  @@index([status])
  @@index([admissionDate])
  @@map("admissions")
}

model BedAllocationHistory {
  id             BigInt    @id @default(autoincrement())
  admissionId    BigInt    @map("admission_id")
  bedId          BigInt    @map("bed_id")
  allocatedAt    DateTime  @map("allocated_at") @db.Timestamptz
  releasedAt     DateTime? @map("released_at") @db.Timestamptz
  rateSnapshot   Decimal   @default(0.00) @map("rate_snapshot") @db.Decimal(10, 2)
  transferReason String?   @map("transfer_reason") @db.VarChar(255)
  allocatedBy    BigInt?   @map("allocated_by")
  releasedBy     BigInt?   @map("released_by")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  admission      Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  bed            Bed       @relation(fields: [bedId], references: [id])

  @@index([admissionId])
  @@index([bedId])
  @@index([releasedAt])
  @@map("bed_allocation_history")
}

model InpatientFolio {
  id             BigInt    @id @default(autoincrement())
  folioNumber    String    @unique @map("folio_number") @db.VarChar(50) // FOL-YYYYMMDD-XXXX
  admissionId    BigInt    @unique @map("admission_id")
  patientId      BigInt    @map("patient_id")
  status         String    @default("OPEN") @db.VarChar(50) // OPEN, CLOSED, SETTLED
  totalCharges   Decimal   @default(0.00) @map("total_charges") @db.Decimal(12, 2)
  totalPaid      Decimal   @default(0.00) @map("total_paid") @db.Decimal(12, 2)
  balance        Decimal   @default(0.00) @db.Decimal(12, 2)
  settledAt      DateTime? @map("settled_at") @db.Timestamptz
  settledBy      BigInt?   @map("settled_by")
  finalInvoiceId BigInt?   @map("final_invoice_id")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  admission      Admission            @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patient        Patient              @relation(fields: [patientId], references: [id])
  finalInvoice   Payment?             @relation(fields: [finalInvoiceId], references: [id])
  items          InpatientFolioItem[]

  @@index([patientId])
  @@index([status])
  @@map("inpatient_folios")
}

model InpatientFolioItem {
  id             BigInt    @id @default(autoincrement())
  folioId        BigInt    @map("folio_id")
  sourceModule   String    @map("source_module") @db.VarChar(50) // BED, PHARMACY, LABORATORY, RADIOLOGY, SERVICE
  sourceRecordId String?   @map("source_record_id") @db.VarChar(100) // Dispensation ID, Lab Order ID, etc.
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(150) // Prevents duplicate charges
  chargeCategory String    @map("charge_category") @db.VarChar(100)
  description    String    @db.VarChar(255)
  quantity       Int       @default(1)
  unitPrice      Decimal   @map("unit_price") @db.Decimal(10, 2)
  totalAmount    Decimal   @map("total_amount") @db.Decimal(12, 2)
  postedAt       DateTime  @default(now()) @map("posted_at") @db.Timestamptz
  postedBy       BigInt?   @map("posted_by")
  isReversed     Boolean   @default(false) @map("is_reversed")
  reversedAt     DateTime? @map("reversed_at") @db.Timestamptz
  reversedBy     BigInt?   @map("reversed_by")
  reversalReason String?   @map("reversal_reason") @db.VarChar(255)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  folio          InpatientFolio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@index([sourceModule, sourceRecordId])
  @@map("inpatient_folio_items")
}

model MedicalHistory {
  id               BigInt    @id @default(autoincrement())
  patientId        BigInt    @map("patient_id")
  title            String    @db.VarChar(100)
  description      String    @db.Text
  date             String    @db.VarChar(50)
  imgUrl           String?   @map("img_url") @db.VarChar(255)
  patientName      String?   @map("patient_name") @db.VarChar(100)
  patientPhone     String?   @map("patient_phone") @db.VarChar(50)
  patientAddress   String?   @map("patient_address") @db.VarChar(255)
  registrationTime DateTime? @default(now()) @map("registration_time") @db.Timestamptz
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("medical_history")
}

model PatientDeposit {
  id              BigInt    @id @default(autoincrement())
  patientId       BigInt    @map("patient")
  depositedAmount Decimal   @map("deposited_amount") @db.Decimal(10, 2)
  date            String    @db.VarChar(50)
  user            String?   @db.VarChar(50)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("patient_deposit")
}

// =============================================================================
// 4. APPOINTMENTS, CLINICS & OPD SCHEDULING
// =============================================================================

model Doctor {
  id            BigInt    @id @default(autoincrement())
  name          String    @db.VarChar(100)
  email         String?   @db.VarChar(100)
  phone         String?   @db.VarChar(50)
  address       String?   @db.VarChar(255)
  department    String?   @db.VarChar(100)
  profile       String?   @db.Text
  imageUrl      String?   @map("img_url") @db.VarChar(255)
  x             String?   @default("") @db.VarChar(50)
  y             String?   @default("") @db.VarChar(50)
  ionUserId     String?   @map("ion_user_id") @db.VarChar(50)
  procedureId   String?   @map("procedure_id") @db.VarChar(100)
  sharePolicyId BigInt?   @map("share_policy_id")
  branchId      BigInt?   @map("branch_id")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  branch          HospitalBranch?   @relation(fields: [branchId], references: [id])
  appointments    Appointment[]
  slots           DoctorSlot[]
  slotBlocks      SlotBlock[]
  visitFees       VisitFee[]
  consultations   Consultation[]
  consultTemplates ConsultTemplate[]
  prescriptions   Prescription[]
  labOrders       Lab[]
  radiologyOrders RadiologyOrder[]
  doctorShares    DoctorShare[]
  invoiceItems    InvoiceItem[]
  pharmacyDispensations PharmacyDispensation[]
  attendingAdmissions   Admission[] @relation("AttendingDoctor")
  admittingAdmissions   Admission[] @relation("AdmittingDoctor")

  @@index([email])
  @@index([department])
  @@index([branchId])
  @@map("doctor")
}

model Appointment {
  id               BigInt    @id @default(autoincrement())
  patientId        BigInt    @map("patient")
  doctorId         BigInt    @map("doctor")
  date             String    @db.VarChar(50)
  timeSlot         String?   @map("time_slot") @db.VarChar(100)
  sTime            String    @map("s_time") @db.VarChar(50) // e.g. "2026-10-01 09:00:00"
  eTime            String    @map("e_time") @db.VarChar(50) // e.g. "2026-10-01 09:30:00"
  sTimeKey         String?   @map("s_time_key") @db.VarChar(50)
  status           String    @default("scheduled") @db.VarChar(50)
  remarks          String?   @db.Text
  addDate          String?   @map("add_date") @db.VarChar(50)
  registrationTime String?   @map("registration_time") @db.VarChar(50)
  user             String?   @default("") @db.VarChar(100)
  request          String?   @default("") @db.VarChar(100)
  bp               String?   @map("b_p") @db.VarChar(100)
  pulse            String?   @db.VarChar(100)
  temperature      String?   @map("temprature") @db.VarChar(100)
  weight           String?   @db.VarChar(100)
  tokenNo          Int?      @map("token_no")
  queueNumber      Int?      @map("queue_number")
  tokenNumber      String?   @map("token_number") @db.VarChar(50)
  visitType        String?   @default("first_visit") @map("visit_type") @db.VarChar(50)
  paymentId        BigInt?   @map("payment_id")
  mode             String    @default("in_person") @db.VarChar(20) // in_person or video
  videoRoom        String?   @map("video_room") @db.VarChar(100)
  branchId         BigInt?   @map("branch_id")
  checkedInAt      DateTime? @map("checked_in_at") @db.Timestamptz
  consultStartedAt DateTime? @map("consult_started_at") @db.Timestamptz
  calledInAt       DateTime? @map("called_in_at") @db.Timestamptz
  checkedOutAt     DateTime? @map("checked_out_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient      Patient         @relation(fields: [patientId], references: [id])
  doctor       Doctor          @relation(fields: [doctorId], references: [id])
  branch       HospitalBranch? @relation(fields: [branchId], references: [id])
  consultation    Consultation?
  labs            Lab[]
  radiologyOrders RadiologyOrder[]

  @@index([doctorId, date])
  @@index([patientId])
  @@index([status])
  @@index([sTimeKey])
  @@index([branchId])
  @@map("appointment")
}

model DoctorSlot {
  id          BigInt    @id @default(autoincrement())
  doctorId    BigInt    @map("doctor_id")
  weekday     Int // 0=Sunday .. 6=Saturday
  startTime   String    @map("start_time") @db.VarChar(5) // HH:mm
  endTime     String    @map("end_time") @db.VarChar(5)   // HH:mm
  slotMinutes Int       @default(15) @map("slot_minutes")
  active      Boolean   @default(true)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@index([doctorId, weekday])
  @@map("doctor_slot")
}

model SlotBlock {
  id        BigInt    @id @default(autoincrement())
  doctorId  BigInt    @map("doctor_id")
  date      DateTime  @db.Date
  startTime String?   @map("start_time") @db.VarChar(5)
  endTime   String?   @map("end_time") @db.VarChar(5)
  reason    String?   @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
