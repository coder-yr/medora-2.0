# ==============================================================================
# Medora 2.0 Environment Configuration Template
# ==============================================================================
# Target Stack:
#   - Frontend: React + TypeScript + Vite
#   - Backend: NestJS + TypeScript
#   - Database Platform: Supabase PostgreSQL
#   - ORM: Prisma
#   - Background Processing: Redis + BullMQ
#
# SECURITY RULES:
#   1. NEVER commit real credentials, service keys, or secrets to version control.
#   2. NEVER expose SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, or DIRECT_URL to the frontend.
#   3. The NestJS backend is the sole trusted authority for business operations.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Application Environment (NestJS)
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="Medora 2.0"
APP_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Database Configuration — Supabase PostgreSQL with Prisma ORM
# ------------------------------------------------------------------------------
# Pooled Connection URL (Supavisor / pgbouncer, transaction mode, port 6543)
# Used by runtime NestJS application traffic:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15"

# Direct Connection URL (port 5432)
# Required by Prisma CLI for migrations, schema push, and advisory locks:
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Platform Keys (DO NOT EXPOSE SERVICE_ROLE_KEY TO CLIENTS)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-private-service-role-key-backend-only"

# ------------------------------------------------------------------------------
# Background Processing — Redis & BullMQ
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# ------------------------------------------------------------------------------
# Authentication & JWT Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_jwt_secret_token_in_production
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=replace_with_a_secure_random_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite + React)
# Only variables prefixed with VITE_ are accessible in the browser bundle
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# ------------------------------------------------------------------------------
# Legacy ICTHospital Bridge (Optional / Read-Only Reference)
# ------------------------------------------------------------------------------
LEGACY_DB_CONNECTION=sqlite
LEGACY_DB_DATABASE=legacy/database/database.sqlite
LEGACY_APP_URL=http://localhost:8000
